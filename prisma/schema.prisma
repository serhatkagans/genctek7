// GençTek Ekosistemi Kurumsal Bilgi Sistemi — veri modeli
//
// references/data-model.md'nin Prisma karşılığıdır. Tablo ve alan adları Türkçe,
// veritabanında snake_case olarak tutulur.
//
// UYARI: Bu dosyada ifade EDİLEMEYEN kısıtlar vardır. Bir öğretmenin aynı anda
// hem danışman hem il koordinatörü olamaması, bir öğrencinin tek aktif danışmanı
// olması ve aynı faaliyete aktif ikinci başvuru yapılamaması kısmi (partial)
// unique index gerektirir; Prisma şema dili bunu desteklemediği için
// migrations/ altındaki SQL dosyalarında tanımlıdır. Şemayı değiştirirken o
// index'leri de gözden geçir.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Numaralandırmalar
// ---------------------------------------------------------------------------

enum RolKodu {
  OGRENCI
  DANISMAN
  IL_KOORDINATOR
  PROJE_YONETICISI
  /// EBA hesabı olmayan, proje yöneticisinin onayıyla giren kullanıcılar.
  ///
  /// Diğer dört rolden temel farkları: kurum kodları YOKTUR ve kimlikleri
  /// AuthProvider'dan gelmez (bkz. model DisKimlik). Kapsam filtreleri il ve
  /// kurum ekseninde çalıştığı için bu iki rol her filtrede AÇIKÇA ele
  /// alınmalıdır — varsayılan "hiçbir şey görmez"dir.
  MEZUN
  /// Paydaş kurumun sistemdeki temsilcisi. Kurum kaydının kendisi `paydas`
  /// tablosundadır; bu rol o kayda bağlı bir KİŞİdir.
  PAYDAS_TEMSILCISI
}

/// Dış başvurunun hangi grup için yapıldığı.
///
/// RolKodu ile birebir eşleşir (MEZUN → MEZUN, PAYDAS → PAYDAS_TEMSILCISI) ama
/// ayrı tutulur: başvuru henüz bir rol değildir, rol yalnızca onayla doğar.
/// Aynı enum kullanılsaydı onaysız bir başvuru satırı rol adı taşırdı.
enum DisKullaniciTuru {
  MEZUN
  PAYDAS
  /// Dışarıdan mentörlük yapmak için başvuran kişi (7 Ağustos 2026).
  ///
  /// Mezun ve paydaştan farkı, ekosisteme bağının bir OKUL ya da KURUM
  /// üzerinden değil, bildiği KONULAR üzerinden kurulması. Mezun ve paydaş da
  /// ayrıca mentörlük isteyebilir — o zaman türleri değişmez, başvuruya
  /// mentörlük işareti eklenir.
  MENTOR
}

/// Mentörlük başvurusunun durumu.
///
/// `OnayDurumu` PAYLAŞILMADI: o enum'da `ONAY_GEREKMEZ` var ve mentörlükte
/// böyle bir hâl yok — her mentörlük onaydan geçer. Paylaşılan enum, hiçbir
/// zaman kullanılmayacak bir değeri sürekli ele almayı zorunlu kılardı.
enum MentorlukDurumu {
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
  /// Kişi mentörlüğü kendi bıraktı. Reddedilmekten AYRI: ret bir karardır,
  /// bu bir vazgeçmedir ve geçmişe dönük "bu kişi reddedilmişti" izlenimi
  /// bırakmamalı.
  BIRAKILDI
}

enum AtamaTipi {
  OGRENCI_SECTI
  OTOMATIK
  IL_KOORDINATOR_FALLBACK
  DEVIR
}

enum KapanmaNedeni {
  OGRETMEN_AYRILDI
  OGRENCI_OKUL_DEGISTIRDI
  YENIDEN_SECIM
  DEVIR
  DANISMANLIK_BIRAKILDI
  /// Danışman öğretmen il koordinatörü olarak atandı.
  IL_KOORDINATORU_OLDU
  /// Öğrenci kendi isteğiyle danışmanını değiştirdi.
  OGRENCI_ISTEGI
  /// Öğrenci danışmanlığı KENDİSİ sonlandırdı; yerine kimseyi seçmedi
  /// (11 Ağustos 2026).
  ///
  /// OGRENCI_ISTEGI'nden AYRI TUTULDU: o, "başka birini seçti" demek ve
  /// arkasından hemen yeni bir atama satırı gelir. Bu ise öğrencinin
  /// danışmansız kaldığı andır — geçmiş tablosunda ikisi aynı kodla dursaydı
  /// "kaç öğrenci danışmansız kaldı" sorusu cevaplanamazdı. Otomatik yeniden
  /// bağlama da bu koda bakıyor (bkz. lib/danisman/atama.ts · ilkAtamayiYurut).
  OGRENCI_BIRAKTI
}

enum GorevRolKodu {
  IL_TEMSILCISI
  ILCE_TEMSILCISI
  OKUL_TEMSILCISI
  /// Bir çalışma grubunun öğrenci yöneticisi (7 Ağustos 2026).
  ///
  /// Diğer üçünden farkı KAPSAMININ NE OLDUĞU: onlar bir YERE (il, ilçe, okul)
  /// bağlanır, bu bir ÇALIŞMA GRUBUNA. Kapsam sütunu bu yüzden ayrı
  /// (`calisma_grubu_id`); yer sütunlarına sığdırılsaydı "Robotik" bir okul
  /// adıymış gibi durur ve etiket yanlış yazılırdı.
  ///
  /// Bugün ek YETKİ getirmez, bir unvandır — profildeki "Görevlerim"
  /// bölümünde görünür. Yetki eklenecekse `permissions.md` ile birlikte
  /// düşünülmeli.
  CALISMA_GRUBU_YONETICISI
}

enum KazanimTipi {
  /// Öğrencinin BEYAN ettiği GençTek etkinliği katılımı.
  ///
  /// Katılım normalde basvuru + faaliyet kayıtlarından OTOMATİK gelir ve
  /// profilde "Katıldığım faaliyetler" olarak görünür. Bu tip, sisteme hiç
  /// girilmemiş eski etkinlikler için elle giriş sağlar; kayıt doğrulanmaz ve
  /// otomatik listeyle çakışabilir. Rozetler bu kayıtlardan HESAPLANMAZ.
  GENCTEK_ETKINLIGI
  DIS_ETKINLIK
  URUN
  AKRAN_EGITIMI
  YARISMA_DERECESI
  /// Aldığı sertifika ve katılım belgeleri. Belgenin kendisi `kazanim_ek`
  /// altyapısıyla yüklenir; ayrı bir dosya alanı açılmadı.
  SERTIFIKA
  /// İçinde yer aldığı kulüp, proje ekibi, takım. BEYANDIR — sistem
  /// doğrulamaz, danışman onayına da tabi değildir.
  TOPLULUK
  /// Yukarıdakilerin hiçbirine girmeyen katkılar.
  DIGER
}

/// Bir etkinliğin/eğitimin nasıl yürütüldüğü. Yalnızca öğrenci kazanım
/// kayıtlarında sorulur; faaliyetlerde YOKTUR — faaliyetin yeri kapsamından ve
/// açıklamasından okunur, kazanım ise dışarıdan gelen bir beyandır ve "nerede
/// yapıldı" bilgisi başka hiçbir alandan çıkarılamaz.
enum KatilimBicimi {
  YUZ_YUZE
  ONLINE
  KARMA
}

/// "Rotam" hedefinin durumu. VAZGEÇİLDİ diye bir değer YOK: vazgeçilen hedef
/// silinir. Ayrı bir durum, öğrencinin profilinde yapmaktan vazgeçtiği
/// şeylerin kalıcı bir listesini tutmak demek olurdu.
enum HedefDurumu {
  PLANLANDI
  SURUYOR
  TAMAMLANDI
}

/// Bir envanter uygulamasının durumu (Algoritmam · E).
///
/// YARIDA BIRAKMAK NORMAL SAYILIR: envanterler 20–25 maddelik ve tek oturumda
/// bitirilmek zorunda değil. "VAZGEÇTİ" diye üçüncü bir durum yok — vazgeçilen
/// uygulama silinir; ayrı bir durum, kişinin yarım bıraktığı denemelerin
/// kalıcı listesini tutmak olurdu.
enum EnvanterDurumu {
  SURUYOR
  TAMAMLANDI
}

/// Faaliyetin KİME AÇIK olduğunu belirler. Etkinliğin niteliğini belirleyen
/// EtkinlikKategorisi'nden bağımsızdır: her kapsam her kategoriyle birleşebilir.
enum Kapsam {
  OKUL
  IL
  ULUSAL
}

/// Faaliyetin NİTELİĞİ — Kapsam'dan ayrı ve bağımsız bir alandır.
enum EtkinlikKategorisi {
  /// GençTek'in ulusal düzeyde her yıl tekrarlanan, adı sabit programları.
  TEMEL_ETKINLIK
  /// Çalışma grubu öğrencilerinin yıl boyunca yürüttüğü, adı sabit programlar.
  CALISMA_GRUBU_ETKINLIGI
  /// İl koordinatörünün kendi iline özel tasarladığı temalı etkinlik. Sabit
  /// isim listesi YOKTUR; faaliyetin ad alanı temayı taşır.
  IL_ETKINLIGI
}

/// temel_etkinlik_programi kayıtlarının hangi kategoriye ait olduğu.
enum TemelEtkinlikGrubu {
  TEMEL_ETKINLIK
  CALISMA_GRUBU_ETKINLIGI
}

enum FaaliyetDurumu {
  AKTIF
  IPTAL_EDILDI
}

enum OnayDurumu {
  ONAY_GEREKMEZ
  BEKLIYOR
  ONAYLANDI
  REDDEDILDI
}

enum BasvuruDurumu {
  BEKLIYOR
  SECILDI
  REDDEDILDI
  YEDEK
  GERI_CEKILDI
  /// Faaliyet iptal edildiği için sistem tarafından kapatıldı. Öğrencinin
  /// kendi geri çekmesiyle (GERI_CEKILDI) karıştırılmamalıdır.
  IPTAL_EDILDI
}

/// Üretilen katılım / teşekkür belgesinin türü.
///
/// `lib/belge/kurallar.ts` içindeki BELGE_TURLERI ile AYNI değerleri taşır ve
/// taşımak zorundadır: oradaki liste belgenin METNİNİ seçer, buradaki enum
/// üretimin KAYDINI tutar. İkisi ayrışırsa kaydedilemeyen bir belge türü
/// doğar — bu yüzden yeni tür eklenirken iki yer birlikte güncellenmeli.
enum FaaliyetBelgeTuru {
  KATILIM
  TESEKKUR
}

enum LogIslemi {
  GORUNTULEME
  DEGISIKLIK
  SILME
}

enum LogHedefTip {
  OGRENCI
  OGRETMEN
  FAALIYET
  YORUM
  FAALIYET_EK
  BASVURU
  ROL
  DANISMAN_ATAMA
  PROFIL
  /// Denetim kayıtlarına kimin baktığı da kayda geçer: denetçi denetimsiz kalmaz.
  ERISIM_LOGU
  SISTEM_AYARI
  CALISMA_GRUBU
  ETKINLIK_PROGRAMI
  PAYDAS
  BILDIRIM_SABLONU
  /// EBA dışı kullanıcı başvurusu (kayıt, onay, ret). Başvuru sahibinin henüz
  /// kullanıcı kaydı olmayabileceği için hedefId başvurunun kendi kimliğidir.
  DIS_BASVURU
}

enum GonderimKanali {
  EPOSTA
  SMS
  SISTEM
}

/// Bildirim kopyasının (e-posta ya da SMS) akıbeti. Panel bildirimi her koşulda
/// yazılır; bu alan yalnızca kopyanın ne olduğunu anlatır. İki kanal için TEK
/// enum kullanılır: durumlar birebir aynı ve ayrı tutmak, aynı listeyi iki
/// yerde güncel tutma yükü getirirdi.
enum GonderimDurumu {
  /// Gönderilmedi: kanal kapalı ya da kişinin adresi/numarası yok. Hata değildir.
  GEREKMIYOR
  GONDERILDI
  BASARISIZ
}

/// Kullanıcıdan onayı istenen belgeler.
///
/// Dördü de AYRI kayıt tutar çünkü ayrı yükümlülüklerdir: biri kalkarsa ya da
/// metni değişirse diğerlerinin onayı etkilenmemeli. Kimden isteneceği koddadır
/// (bkz. lib/kvkk/kurallar.ts · BELGE_TANIMLARI), veritabanında değil — rol
/// eşlemesi bir iş kuralıdır, veri değil.
enum OnayBelgesi {
  /// KVKK aydınlatma metni — "verini şöyle işliyoruz". Öğrenciden istenir.
  AYDINLATMA
  /// KVKK açık rıza onayı — aydınlatmadan AYRI bir irade beyanıdır ve
  /// sistemdeki HERKESTEN istenir.
  ACIK_RIZA
  /// İl koordinatörü görev taahhütnamesi — görevin nasıl yürütüleceği.
  TAAHHUTNAME
  /// İl koordinatörü gizlilik sözleşmesi — başkasının verisiyle nasıl
  /// davranılacağı. Taahhütnameden ayrıdır: biri görevle, öbürü veriyle ilgili.
  GIZLILIK_SOZLESMESI
}

/// İl bazlı iş birliği yapılabilecek paydaş kurumun türü. Liste sabittir:
/// çalışma grupları gibi büyüyen bir liste değil, kurumsal sınıflandırmadır.
enum PaydasTuru {
  UNIVERSITE
  /// GençTek iş birliği protokolü olan üniversite. UNIVERSITE'den ayrı tutulur:
  /// ikisi de üniversitedir ama protokollü olan koordinatöre farklı bir kapı
  /// açar ve listede ayırt edilebilmesi gerekir.
  GENCTEK_UNIVERSITE
  /// Programdan geçmiş, artık paydaş olarak dönen kişi ya da oluşum.
  MEZUN
  OZEL_SEKTOR
  STK
  KAMU_KURUMU
  MESLEK_KURULUSU
  BELEDIYE
  DIGER
}

// ---------------------------------------------------------------------------
// 1. Referans tabloları — MEB kaynaklarından beslenir, uygulama içinden düzenlenmez
// ---------------------------------------------------------------------------

model Il {
  ilKodu String @id @map("il_kodu") @db.Char(2)
  ad     String @db.VarChar(100)

  ilceler          Ilce[]
  kurumlar         Kurum[]
  kullanicilar     Kullanici[]
  roller           KullaniciRol[]
  faaliyetler      Faaliyet[]
  ogrenciGorevleri OgrenciGorevRolu[]
  paydaslar        Paydas[]
  disBasvurular    DisKullaniciBasvurusu[]
  ekipler          Ekip[]

  @@map("il")
}

model Ilce {
  ilceKodu String @id @map("ilce_kodu") @db.Char(4)
  ilKodu   String @map("il_kodu") @db.Char(2)
  ad       String @db.VarChar(100)

  il               Il                 @relation(fields: [ilKodu], references: [ilKodu])
  kurumlar         Kurum[]
  kullanicilar     Kullanici[]
  faaliyetler      Faaliyet[]
  ogrenciGorevleri OgrenciGorevRolu[]

  @@index([ilKodu])
  @@map("ilce")
}

model Kurum {
  kurumKodu Int     @id @map("kurum_kodu")
  ad        String  @db.VarChar(250)
  ilKodu    String  @map("il_kodu") @db.Char(2)
  ilceKodu  String  @map("ilce_kodu") @db.Char(4)
  okulTuru  String  @map("okul_turu") @db.VarChar(120)
  aktif     Boolean @default(true)

  il               Il                      @relation(fields: [ilKodu], references: [ilKodu])
  ilce             Ilce                    @relation(fields: [ilceKodu], references: [ilceKodu])
  kullanicilar     Kullanici[]
  roller           KullaniciRol[]
  faaliyetler      Faaliyet[]
  ogrenciGorevleri OgrenciGorevRolu[]
  mezunBasvurulari DisKullaniciBasvurusu[]
  ekipler          Ekip[]

  @@index([ilKodu])
  @@index([ilceKodu])
  @@map("kurum")
}

// ---------------------------------------------------------------------------
// 2. Kullanıcı ve rol
// ---------------------------------------------------------------------------

/// AuthProvider'dan (mock aşamada test kullanıcıları, sonra EBA SSO) gelen kimlik.
/// ad, soyad, cinsiyet, kurumKodu, ilKodu, ilceKodu, sinif, brans ve
/// egitimOgretimYili SALT OKUNUR alanlardır — hiçbir ekrandan düzenlenemez,
/// yalnızca AuthProvider senkronizasyonu günceller.
///
/// TEK İSTİSNA KAYNAKTADIR, KURALDA DEĞİL: mezun ve paydaş temsilcisi
/// kullanıcılarının bu alanları AuthProvider'dan değil onaylanmış başvuru
/// kaydından gelir (bkz. model DisKullaniciBasvurusu). Alanlar onlarda da salt
/// okunurdur — düzeltme, başvuruyu onaylayan proje yöneticisinden istenir.
model Kullanici {
  id                Int      @id @default(autoincrement())
  authProviderId    String   @unique @map("auth_provider_id") @db.VarChar(64)
  ad                String   @db.VarChar(100)
  soyad             String   @db.VarChar(100)
  cinsiyet          String   @db.Char(1)
  /// Proje yöneticisi (YEĞİTEK) bir okula bağlı olmadığı için null olabilir.
  kurumKodu         Int?     @map("kurum_kodu")
  ilKodu            String?  @map("il_kodu") @db.Char(2)
  ilceKodu          String?  @map("ilce_kodu") @db.Char(4)
  sinif             String?  @db.VarChar(10)
  brans             String?  @db.VarChar(100)
  egitimOgretimYili String   @map("egitim_ogretim_yili") @db.VarChar(9)
  sonSenkronTarihi  DateTime @default(now()) @map("son_senkron_tarihi") @db.Timestamptz(6)
  aktif             Boolean  @default(true)
  olusturmaTarihi   DateTime @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)

  /// Kişinin kendi yüklediği profil fotoğrafı — e-Okul'dan GELMEZ, gecelik
  /// senkronda üzerine yazılmaz (kimlik alanlarından farkı budur).
  ///
  /// Profil tablolarında DEĞİL burada durur: fotoğraf her kullanıcı tipinde
  /// vardır, oysa YEĞİTEK personeline sağlama akışında ne ogrenci_profil ne
  /// ogretmen_profil satırı açılır (bkz. lib/kullanici/sagla.ts). Profil
  /// tablosuna konsaydı personel bu alanı hiç kullanamazdı.
  ///
  /// Saklanan şey dosya yolu değil, depolama sağlayıcısının ANAHTARIDIR;
  /// anlamını yalnızca sağlayıcı bilir (bkz. lib/depolama/tipler.ts).
  fotoDepolamaYolu   String?   @map("foto_depolama_yolu") @db.VarChar(120)
  fotoMimeTipi       String?   @map("foto_mime_tipi") @db.VarChar(100)
  fotoYuklenmeTarihi DateTime? @map("foto_yuklenme_tarihi") @db.Timestamptz(6)

  /// Kişinin KENDİ yazdığı tanıtım metni — LinkedIn'deki "Hakkında".
  ///
  /// Fotoğrafla aynı gerekçeyle burada, profil tablolarında değil: her
  /// kullanıcı tipinde vardır, oysa YEĞİTEK personeline ne ogrenci_profil ne
  /// ogretmen_profil satırı açılır (bkz. lib/kullanici/sagla.ts).
  ///
  /// Salt okunur kimlik alanlarından AYRIDIR: e-Okul'dan gelmez ve senkron bu
  /// sütuna dokunmaz — güncelleme yalnızca adı geçen sütunlara yazar.
  hakkinda String? @db.Text

  kurum Kurum? @relation(fields: [kurumKodu], references: [kurumKodu])
  il    Il?    @relation(fields: [ilKodu], references: [ilKodu])
  ilce  Ilce?  @relation(fields: [ilceKodu], references: [ilceKodu])

  roller         KullaniciRol[]   @relation("RolSahibi")
  atadigiRoller  KullaniciRol[]   @relation("RolAtayan")
  ogretmenProfil OgretmenProfil?
  ogrenciProfil  OgrenciProfil?
  /// Onayladığı belgeler. Profil tablolarında DEĞİL burada: proje yöneticisinin
  /// ne öğrenci ne öğretmen profili açılıyor (bkz. lib/kullanici/sagla.ts),
  /// oysa açık rıza ondan da isteniyor.
  onaylar        KullaniciOnayi[]

  onayladigiIlDisiBasvurular  Basvuru[]        @relation("BasvuruKaynakIlOnaylayan")
  yazdigiRaporlar             FaaliyetRaporu[] @relation("RaporYazan")
  actigiTalepler              Talep[]          @relation("TalepAcan")
  kararVerdigiTalepler        Talep[]          @relation("TalepOnaylayan")
  gonderdigiBaglantiIstekleri BaglantiIstegi[] @relation("BaglantiIsteyen")
  aldigiBaglantiIstekleri     BaglantiIstegi[] @relation("BaglantiHedefi")
  kararVerdigiBaglantilar     BaglantiIstegi[] @relation("BaglantiKararVeren")
  yazdigiMesajlar             Mesaj[]          @relation("MesajYazan")
  gizledigiMesajlar           Mesaj[]          @relation("MesajGizleyen")

  ogrenciAtamalari  DanismanAtama[] @relation("AtamaOgrencisi")
  danismanAtamalari DanismanAtama[] @relation("AtamaDanismani")

  calismaGruplari       OgrenciCalismaGrubu[] @relation("GrupSecimOgrencisi")
  ekledigiGrupSecimleri OgrenciCalismaGrubu[] @relation("GrupSecimEkleyen")
  gorevRolleri          OgrenciGorevRolu[]    @relation("GorevSahibi")
  atadigiGorevler       OgrenciGorevRolu[]    @relation("GorevAtayan")
  kazanimlar            KullaniciKazanim[]
  hedefler              KullaniciHedefi[]
  /// Algoritmam envanterleri. Hedefler gibi KİŞİYE ÖZELDİR: danışmanın ve
  /// koordinatörün sorgularında hiç görünmez.
  envanterUygulamalari  EnvanterUygulamasi[]

  duzenledigiFaaliyetler Faaliyet[]   @relation("FaaliyetDuzenleyen")
  onayladigiFaaliyetler  Faaliyet[]   @relation("FaaliyetOnaylayan")
  iptalEttigiFaaliyetler Faaliyet[]   @relation("FaaliyetIptalEden")
  yukledigiEkler         FaaliyetEk[] @relation("EkYukleyen")
  sildigiEkler           FaaliyetEk[] @relation("EkSilen")
  yorumlar               Yorum[]      @relation("YorumYazan")
  sildigiYorumlar        Yorum[]      @relation("YorumSilen")

  basvurular                Basvuru[] @relation("BasvuruKatilimcisi")
  adinaYaptigiBasvurular    Basvuru[] @relation("BasvuruAdinaBasvuran")
  degerlendirdigiBasvurular Basvuru[] @relation("BasvuruDegerlendiren")
  aldigiYoklamalar          Basvuru[] @relation("BasvuruYoklamaAlan")

  /// Adına belge üretilmiş etkinlikler. Profildeki "Katıldığı GençTek
  /// etkinlikleri" listesinin yeni kaynağı (bkz. lib/kazanim/getir.ts).
  aldigiBelgeler   FaaliyetBelgesi[] @relation("BelgeSahibi")
  urettigiBelgeler FaaliyetBelgesi[] @relation("BelgeUreten")

  /// Mentörlük kaydı — öğretmende de dış kullanıcıda da aynı tablo.
  mentorluk             Mentorluk?  @relation("MentorlukSahibi")
  kararVerdigiMentorluk Mentorluk[] @relation("MentorlukKararVeren")

  /// Katkı verebileceğini bildirdiği çalışma grupları (mentörlükten ayrı).
  destekGruplari KullaniciDestekGrubu[] @relation("DestekGrubuSahibi")

  ekledigiPaydaslar Paydas[] @relation("PaydasEkleyen")

  /// EBA dışı kullanıcının şifreli giriş kimliği. EBA/mock kimlikli
  /// kullanıcılarda YOKTUR — şifre yalnızca kimliği AuthProvider'dan gelmeyen
  /// kişilerde vardır.
  disKimlik                 DisKimlik?
  /// Kullanıcıyı doğuran başvuru. Mezun/paydaşın hangi okuldan mezun olduğu
  /// ya da hangi paydaş kurumu temsil ettiği buradan okunur; alanlar kullanıcı
  /// satırına KOPYALANMAZ, tek doğruluk kaynağı başvurudur.
  disBasvurusu              DisKullaniciBasvurusu?  @relation("DisBasvuruKullanicisi")
  kararVerdigiDisBasvurular DisKullaniciBasvurusu[] @relation("DisBasvuruKararVeren")

  erisimLoglari Erisimlogu[]
  bildirimler   Bildirim[]

  gonderiler          Gonderi[]       @relation("GonderiYazan")
  gizledigiGonderiler Gonderi[]       @relation("GonderiGizleyen")
  gonderiYorumlari    GonderiYorumu[] @relation("GonderiYorumuYazan")
  gizledigiYorumlar   GonderiYorumu[] @relation("GonderiYorumuGizleyen")

  talepCevaplari        TalepCevabi[] @relation("TalepCevabiYazan")
  gizledigiTalepCevaplari TalepCevabi[] @relation("TalepCevabiGizleyen")

  kurduguEkipler      Ekip[]       @relation("EkipKuran")
  danismanOlduguEkipler  Ekip[]       @relation("EkipDanismani")
  ekipUyelikleri      EkipUyesi[]  @relation("EkipUyesi")
  ekipMesajlari       EkipMesaji[] @relation("EkipMesajiYazan")
  gizledigiEkipMesajlari EkipMesaji[] @relation("EkipMesajiGizleyen")

  @@index([kurumKodu])
  @@index([ilKodu])
  @@map("kullanici")
}

/// Roller geçmişli tutulur: silme yapılmaz, bitisTarihi yazılır.
/// bitisTarihi null olan kayıt aktif roldür.
model KullaniciRol {
  id                Int       @id @default(autoincrement())
  kullaniciId       Int       @map("kullanici_id")
  rolKodu           RolKodu   @map("rol_kodu")
  /// IL_KOORDINATOR rolünün kapsamı.
  ilKodu            String?   @map("il_kodu") @db.Char(2)
  /// DANISMAN rolünün kapsamı.
  kurumKodu         Int?      @map("kurum_kodu")
  baslangicTarihi   DateTime  @default(now()) @map("baslangic_tarihi") @db.Timestamptz(6)
  bitisTarihi       DateTime? @map("bitis_tarihi") @db.Timestamptz(6)
  atayanKullaniciId Int?      @map("atayan_kullanici_id")

  kullanici Kullanici  @relation("RolSahibi", fields: [kullaniciId], references: [id])
  atayan    Kullanici? @relation("RolAtayan", fields: [atayanKullaniciId], references: [id])
  il        Il?        @relation(fields: [ilKodu], references: [ilKodu])
  kurum     Kurum?     @relation(fields: [kurumKodu], references: [kurumKodu])

  @@index([kullaniciId, bitisTarihi])
  @@index([rolKodu, ilKodu])
  @@index([rolKodu, kurumKodu])
  /// Bir ilin aynı anda tek aktif koordinatörü olur; kısıt kısmi unique index
  /// olduğu için migration'da durur (ux_il_koordinator_tek_aktif).
  @@map("kullanici_rol")
}

/// EBA hesabı olmayanların (mezun, paydaş temsilcisi) sisteme giriş başvurusu.
///
/// ONAYLANANA KADAR `kullanici` SATIRI AÇILMAZ. Açılsaydı onaysız kişi
/// sistemde "varmış" gibi görünür, kapsam filtrelerine ve envanter sayılarına
/// sızardı. Kullanıcı yalnızca proje yöneticisinin onayıyla doğar
/// (bkz. lib/dis-kimlik/basvuru.ts).
///
/// SİLME YOKTUR: reddedilen başvuru da durur. "Bu kişi neden alınmadı"
/// sorusunun cevabı gerekiyor ve aynı kişi tekrar başvurabiliyor.
model DisKullaniciBasvurusu {
  id      Int              @id @default(autoincrement())
  tur     DisKullaniciTuru
  ad      String           @db.VarChar(100)
  soyad   String           @db.VarChar(100)
  /// Hem giriş adı hem tebligat adresi. Küçük harfe indirgenmiş olarak
  /// saklanır; büyük/küçük harf farkı iki ayrı hesap doğurmamalı.
  eposta  String           @db.VarChar(150)
  telefon String?          @db.VarChar(20)
  /// Başvuranın ili. Kurum kodu YOKTUR — mezun okulundan ayrılmıştır, paydaş
  /// temsilcisi zaten okula bağlı değildir.
  ilKodu  String           @map("il_kodu") @db.Char(2)

  /// Kişinin başvuruda belirlediği şifre.
  ///
  /// ONAYLA BİRLİKTE `dis_kimlik`e TAŞINIR ve burası NULL'lanır; reddedilen
  /// başvuruda da NULL'lanır. Sır, karara bağlanmış bir başvuru satırında
  /// süresiz durmaz.
  sifreOzeti String? @map("sifre_ozeti") @db.VarChar(200)

  /// MEZUN başvurusunda: mezun olduğu okul ve yılı. Okul isteğe bağlıdır —
  /// kapanmış ya da referans tablosunda bulunmayan bir okuldan mezun olan
  /// kişi başvuramaz hâle gelmemeli.
  mezunKurumKodu Int? @map("mezun_kurum_kodu")
  mezuniyetYili  Int? @map("mezuniyet_yili")

  /// PAYDAS başvurusunda: temsil ettiği kurumun envanterdeki kaydı ve kişinin
  /// oradaki görevi. Kurum envanteri il koordinatörlerince yönetildiği için
  /// başvuran serbest metin kurum adı YAZAMAZ, mevcut kayıttan seçer.
  paydasId    Int?    @map("paydas_id")
  gorevUnvani String? @map("gorev_unvani") @db.VarChar(150)

  /// "Ekosisteme nasıl katkı vermek istiyorsunuz" — kararın verildiği alan.
  /// Zorunlu: adı ve e-postası olan ama ne yapmak istediği yazılmayan bir
  /// başvuru, onaylayan için karar verilemez bir kayıttır.
  beyan String @db.Text

  /// MENTÖRLÜK İSTEĞİ (7 Ağustos 2026 · "Paydaş/Mentör başvurusu tek bir
  /// formdan yapılacak").
  ///
  /// tur=MENTOR olanlarda zorunlu olarak true'dur; mezun ve paydaş da
  /// işaretleyebilir. Onaylanan başvuruda bu alanlardan bir `mentorluk`
  /// kaydı doğar ve BURASI kaynak olmaktan çıkar — sonraki değişiklikler
  /// mentörlük kaydında yapılır, başvuru satırı dondurulmuş bir belgedir.
  mentorlukIstiyor    Boolean @default(false) @map("mentorluk_istiyor")
  /// Mentörlük yapabileceği serbest konular ("3B tasarım, Arduino").
  mentorlukKonulari   String? @map("mentorluk_konulari") @db.Text
  /// Mentörlük yapabileceği çalışma gruplarının kimlikleri.
  ///
  /// JUNCTION TABLO AÇILMADI ve bu bilinçli: değerler yalnızca karar anına
  /// kadar yaşıyor, onayla birlikte `mentorluk_calisma_grubu`na taşınıyor.
  /// Bekleyen bir başvuru için ayrı tablo, onay sonrası boşalan ve kimsenin
  /// sorgulamadığı satırlar bırakırdı. Grup kimlikleri onay anında yeniden
  /// doğrulanır (silinmiş/pasif grup elenir).
  mentorlukGrupIdleri Int[]   @default([]) @map("mentorluk_grup_idleri")

  /// Başvuru anında okutulan aydınlatma metninin onay tarihi.
  ///
  /// Diğer onaylar `kullanici_onayi`ndadır ama bu ORADA TUTULAMAZ: başvuru
  /// anında kullanıcı kaydı henüz yoktur, oysa veri işleme o anda başlar.
  aydinlatmaOnayTarihi DateTime @map("aydinlatma_onay_tarihi") @db.Timestamptz(6)

  /// BEKLIYOR / ONAYLANDI / REDDEDILDI. ONAY_GEREKMEZ bu akışta kullanılmaz;
  /// enum, bağlantı isteğinde olduğu gibi paylaşılıyor.
  durum                 OnayDurumu @default(BEKLIYOR)
  kararVerenKullaniciId Int?       @map("karar_veren_kullanici_id")
  kararTarihi           DateTime?  @map("karar_tarihi") @db.Timestamptz(6)
  /// Rette ZORUNLU (uygulama katmanında): gerekçesiz ret, kişiye tekrar
  /// başvururken neyi düzelteceğini söylemez.
  retGerekcesi          String?    @map("ret_gerekcesi") @db.Text

  /// Onayla açılan kullanıcı. Başvuru ile kullanıcı arasındaki tek bağ budur.
  olusanKullaniciId Int?     @unique @map("olusan_kullanici_id")
  olusturmaTarihi   DateTime @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)

  il              Il         @relation(fields: [ilKodu], references: [ilKodu])
  mezunKurum      Kurum?     @relation(fields: [mezunKurumKodu], references: [kurumKodu])
  paydas          Paydas?    @relation(fields: [paydasId], references: [id])
  kararVeren      Kullanici? @relation("DisBasvuruKararVeren", fields: [kararVerenKullaniciId], references: [id])
  olusanKullanici Kullanici? @relation("DisBasvuruKullanicisi", fields: [olusanKullaniciId], references: [id])

  @@index([durum, olusturmaTarihi])
  @@index([ilKodu])
  @@index([paydasId])
  /// Aynı e-posta için aynı anda tek BEKLEYEN başvuru olur; kısıt kısmi unique
  /// index olduğu için migration'da durur (ux_dis_basvuru_bekleyen_eposta).
  @@map("dis_kullanici_basvurusu")
}

/// MENTÖRLÜK (7 Ağustos 2026).
///
/// İstek iki yerden geldi ve TEK KAYITTA toplandı:
///   · "Öğretmen hesabında 'mentör başvurusu yap' bölümü ekleyelim. hangi
///      çalışma grubunda mentörlük yapabilir seçsin ... yani öğretmen mentör
///      olabilsin"
///   · "Paydaş/Mentör başvurusu tek bir formdan yapılacak."
///
/// İKİ GİRİŞ YOLU, TEK TABLO:
///   · ÖĞRETMEN (EBA'lı kullanıcı) → Panel'den başvurur, kayıt BEKLIYOR
///     durumunda doğar, il koordinatörü ya da proje yöneticisi onaylar.
///   · DIŞARIDAN (mezun/paydaş/mentör) → başvuru formundan ister; kayıt,
///     proje yöneticisi dış başvuruyu onayladığı anda ONAYLANDI olarak doğar
///     (aynı kararı iki kez sormanın anlamı yok).
///
/// İki ayrı yerde tutulsalardı "kimler mentör" sorusunun iki ayrı cevabı olur
/// ve pano süzgeci iki kaynağı birleştirmek zorunda kalırdı.
///
/// KİŞİ BAŞINA TEK KAYIT: mentörlük bir DURUMDUR, geçmiş tablosu değil.
/// Bırakılan mentörlük `BIRAKILDI` olur ve yeniden başvuruda aynı satır
/// `BEKLIYOR`a döner; her başvuru yeni satır açsaydı "şu an mentör mü"
/// sorusu her seferinde sıralama gerektirirdi.
model Mentorluk {
  kullaniciId Int             @id @map("kullanici_id")
  durum       MentorlukDurumu @default(BEKLIYOR)
  /// Çalışma grupları dışında kalan serbest konular ("3B tasarım, Arduino").
  /// Gruplar sabit bir listedir ve mentörlüğün tamamını taşımıyor.
  konular     String?         @db.Text

  basvuruTarihi         DateTime  @default(now()) @map("basvuru_tarihi") @db.Timestamptz(6)
  kararVerenKullaniciId Int?      @map("karar_veren_kullanici_id")
  kararTarihi           DateTime? @map("karar_tarihi") @db.Timestamptz(6)
  /// Rette ZORUNLU (uygulama katmanında): gerekçesiz ret, kişiye tekrar
  /// başvururken neyi düzelteceğini söylemez.
  retGerekcesi          String?   @map("ret_gerekcesi") @db.Text

  kullanici  Kullanici               @relation("MentorlukSahibi", fields: [kullaniciId], references: [id], onDelete: Cascade)
  kararVeren Kullanici?              @relation("MentorlukKararVeren", fields: [kararVerenKullaniciId], references: [id])
  gruplar    MentorlukCalismaGrubu[]

  @@index([durum])
  @@map("mentorluk")
}

/// Mentörün hangi çalışma gruplarında mentörlük yapabildiği.
model MentorlukCalismaGrubu {
  mentorlukKullaniciId Int @map("mentorluk_kullanici_id")
  calismaGrubuId       Int @map("calisma_grubu_id")

  mentorluk    Mentorluk    @relation(fields: [mentorlukKullaniciId], references: [kullaniciId], onDelete: Cascade)
  calismaGrubu CalismaGrubu @relation(fields: [calismaGrubuId], references: [id])

  @@id([mentorlukKullaniciId, calismaGrubuId])
  @@index([calismaGrubuId])
  @@map("mentorluk_calisma_grubu")
}

/// Onaylanmış dış kullanıcının giriş kimliği.
///
/// Sistemin ŞİFRE TUTAN TEK TABLOSUDUR ve bilinçli olarak `kullanici`dan
/// ayrıdır: EBA/mock kimlikli kullanıcıların şifresi yoktur ve olmamalıdır.
/// Ayrı tablo, "şifresi olan kullanıcı" kümesini sorguyla değil şemayla
/// belirler — kullanıcı tablosuna sütun eklenseydi, boş şifreli bir satırın
/// giriş yapamayacağını her seferinde uygulama katmanı garanti etmek zorunda
/// kalırdı.
model DisKimlik {
  kullaniciId Int    @id @map("kullanici_id")
  /// Küçük harfe indirgenmiş; giriş bununla yapılır.
  eposta      String @unique @db.VarChar(150)
  /// scrypt özeti — biçim: scrypt$N$r$p$tuz$ozet (bkz. lib/dis-kimlik/sifre.ts).
  sifreOzeti  String @map("sifre_ozeti") @db.VarChar(200)

  /// Kaba kuvvet koruması. Başarılı girişte sıfırlanır.
  basarisizDeneme  Int       @default(0) @map("basarisiz_deneme")
  kilitBitisTarihi DateTime? @map("kilit_bitis_tarihi") @db.Timestamptz(6)

  /// Parola sıfırlama jetonunun ÖZETİ tutulur, kendisi değil: veritabanını
  /// okuyabilen biri jetonla hesap ele geçirememeli.
  sifirlamaJetonuOzeti   String?   @map("sifirlama_jetonu_ozeti") @db.VarChar(200)
  sifirlamaSonGecerlilik DateTime? @map("sifirlama_son_gecerlilik") @db.Timestamptz(6)

  sonGirisTarihi   DateTime? @map("son_giris_tarihi") @db.Timestamptz(6)
  olusturmaTarihi  DateTime  @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi DateTime  @default(now()) @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id])

  @@map("dis_kimlik")
}

/// danismanOlmakIstiyor false olduğu sürece öğretmen, öğrencinin danışman
/// seçim listesinde GÖRÜNMEZ. Onay süreci yoktur, işaretlemek yeterlidir.
model OgretmenProfil {
  kullaniciId          Int       @id @map("kullanici_id")
  danismanOlmakIstiyor Boolean   @default(false) @map("danisman_olmak_istiyor")
  isaretlemeTarihi     DateTime? @map("isaretleme_tarihi") @db.Timestamptz(6)

  /// YEĞİTEK OKUL SORUMLUSU (13 Ağustos 2026 · istek: "okuldaki danışman
  /// öğretmenlerden bazıları YEĞİTEK Okul Sorumlusu olarak görev alıyor
  /// olabilir … eğer YEĞİTEK okul sorumlusu ise o alanı işaretlesin").
  ///
  /// AYRI BİR ROL DEĞİL, İŞARET: `danisman_olmak_istiyor` ile birebir aynı
  /// desende ve aynı tabloda. Rol yapılsaydı kapsam filtrelerinin hepsine
  /// hiçbir şey değiştirmeyen ikinci bir dal eklenirdi — bu işaret kimseye
  /// yeni bir veri erişimi vermiyor, yalnızca "bu öğretmen okulda YEĞİTEK'in
  /// muhatabı" bilgisini taşıyor.
  ///
  /// ONAY YOK, KİŞİ KENDİ İŞARETLER (danışmanlık işaretiyle aynı): görev okul
  /// idaresi ile YEĞİTEK arasında zaten verilmiş bir görevdir, sistem onu
  /// kaydeder. Merkez listeyi yönetim panosundan görür ve yanlışını
  /// öğretmenle konuşur.
  yegitekOkulSorumlusu Boolean   @default(false) @map("yegitek_okul_sorumlusu")
  /// İşaretin konduğu an; kaldırıldığında null'a döner (isaretlemeTarihi ile
  /// aynı desen). Merkez listesinde "ne zamandır sorumlu" sütununu besler.
  yegitekIsaretlemeTarihi DateTime? @map("yegitek_isaretleme_tarihi") @db.Timestamptz(6)
  /// Kişinin kendi girdiği iletişim bilgisi; e-Okul'dan GELMEZ ve senkronda
  /// üzerine yazılmaz. Öğretmen, il koordinatörü, YEĞİTEK personeli ve dış
  /// kullanıcılar (mezun, paydaş temsilcisi) aynı tabloyu kullanır — iletişim
  /// bilgisi role bağlı bir alan değildir. Tablonun adı tarihseldir: içeriği
  /// "öğrenci OLMAYAN kullanıcının iletişim bilgisi"dir.
  eposta               String?   @db.VarChar(150)
  telefon              String?   @db.VarChar(20)

  /// ÖZGEÇMİŞ (7 Ağustos 2026 · istek: öğretmen profilinde "Özgeçmiş").
  ///
  /// `ogrenci_profil`dekiyle AYNI desende ve aynı sınırlarla; alanlar
  /// kopyalandı, ortak tabloya taşınmadı. Ortak tablo iki profil satırının
  /// yaşam döngüsünü birbirine bağlardı: öğrenci mezun olduğunda öğrenci
  /// profili kapanır, öğretmeninki kapanmaz.
  ///
  /// Saklanan şey dosya yolu değil, depolama sağlayıcısının ANAHTARIDIR.
  cvDosyaAdi       String?   @map("cv_dosya_adi") @db.VarChar(255)
  cvDepolamaYolu   String?   @map("cv_depolama_yolu") @db.Text
  cvMimeTipi       String?   @map("cv_mime_tipi") @db.VarChar(100)
  cvBoyutBayt      BigInt?   @map("cv_boyut_bayt")
  cvYuklenmeTarihi DateTime? @map("cv_yuklenme_tarihi") @db.Timestamptz(6)

  /// MESLEKİ BAĞLANTILAR (7 Ağustos 2026 · istek: mezun/paydaş/mentör profilinde
  /// "linkedin github").
  ///
  /// `ogrenci_profil`dekiyle AYNI sütunlar, aynı doğrulama (bkz.
  /// lib/ogrenci/iletisim-kurallar.ts). Ortak tabloya taşınmadı: iki profil
  /// satırının yaşam döngüsü ayrı — CV alanlarında verilen gerekçenin aynısı.
  ///
  /// Bugüne kadar bu alanlar yalnızca öğrencide vardı; dış kullanıcının
  /// (mezun, paydaş temsilcisi, mentör) ekosisteme ne getirdiğini anlatan
  /// TEK yer bu adreslerdir — okul/sınıf gibi bir kimliği yok.
  githubUrl      String? @map("github_url") @db.VarChar(200)
  kisiselSiteUrl String? @map("kisisel_site_url") @db.VarChar(200)
  linkedinUrl    String? @map("linkedin_url") @db.VarChar(200)

  /// "Açıklamalar / katkı sağlayabileceğim şeyler" (7 Ağustos 2026 · istek).
  ///
  /// Başvurudaki `beyan` alanının YERİNE GEÇMEZ: beyan, onay kararının verildiği
  /// dondurulmuş belgedir ve değişmez. Bu alan kişinin bugünkü hâlidir ve
  /// kendisi günceller.
  aciklama String? @db.Text

  /// Çalıştığı kurum ve oradaki görevi (7 Ağustos 2026 · istek: profilde "kurum
  /// görevi").
  ///
  /// PAYDAŞ ENVANTERİNE BAĞLANMADI ve bu bilinçli: envanter, etkinlikte iş
  /// birliği yapılan KURUMLARIN kaydıdır ve il koordinatörlerince yönetilir.
  /// Mezunun çalıştığı şirketin oraya girmesi gerekmiyor. Başvuruda seçilen
  /// paydaş kurumu ise duruyor; bu alanlar boşken profilde o gösteriliyor
  /// (bkz. app/panel/profil/page.tsx).
  kurumAdi    String? @map("kurum_adi") @db.VarChar(150)
  gorevUnvani String? @map("gorev_unvani") @db.VarChar(150)

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id])

  @@map("ogretmen_profil")
}

/// Kişinin "bu alanlarda katkı verebilirim" dediği çalışma grupları.
///
/// MENTÖRLÜKTEN AYRI (7 Ağustos 2026 · istek: dış kullanıcı panelinde "Çalışma
/// Grupları" ayrı bir bölüm). Mentörlük ONAYA TABİ bir görevdir ve öğrenciyle
/// birebir yazışma hakkı doğurur; buradaki seçim yalnızca bir ilgi/destek
/// beyanıdır — sponsorluk, mekân, eğitmen desteği de olabilir. İkisini aynı
/// tabloda tutmak, mentörlüğü bırakan kişinin destek alanlarını da silerdi.
///
/// `ogrenci_calisma_grubu`dan da AYRI: o tablo öğrencinin hangi grupta
/// çalıştığını söyler ve danışman/koordinatör ekranlarının kaynağıdır. Dış
/// kullanıcıları oraya yazmak, öğrenci listelerine yetişkin karıştırırdı.
model KullaniciDestekGrubu {
  kullaniciId    Int      @map("kullanici_id")
  calismaGrubuId Int      @map("calisma_grubu_id")
  eklenmeTarihi  DateTime @default(now()) @map("eklenme_tarihi") @db.Timestamptz(6)

  kullanici    Kullanici    @relation("DestekGrubuSahibi", fields: [kullaniciId], references: [id], onDelete: Cascade)
  calismaGrubu CalismaGrubu @relation(fields: [calismaGrubuId], references: [id])

  @@id([kullaniciId, calismaGrubuId])
  @@index([calismaGrubuId])
  @@map("kullanici_destek_grubu")
}

// ---------------------------------------------------------------------------
// 3. Danışman atama — GEÇMİŞ TABLOSU
// ---------------------------------------------------------------------------

/// Devir yapılırken güncelleme YAPILMAZ: eski kaydın bitisTarihi yazılır ve
/// yeni kayıt açılır. Aynı öğrenci için aynı anda birden fazla
/// "bitisTarihi IS NULL" kaydı olamaz (kısmi unique index, migration'da).
model DanismanAtama {
  id                  Int            @id @default(autoincrement())
  ogrenciId           Int            @map("ogrenci_id")
  /// Danışman öğretmen ya da fallback durumunda il koordinatörü.
  danismanKullaniciId Int            @map("danisman_kullanici_id")
  atamaTipi           AtamaTipi      @map("atama_tipi")
  baslangicTarihi     DateTime       @default(now()) @map("baslangic_tarihi") @db.Timestamptz(6)
  bitisTarihi         DateTime?      @map("bitis_tarihi") @db.Timestamptz(6)
  kapanmaNedeni       KapanmaNedeni? @map("kapanma_nedeni")

  ogrenci  Kullanici @relation("AtamaOgrencisi", fields: [ogrenciId], references: [id])
  danisman Kullanici @relation("AtamaDanismani", fields: [danismanKullaniciId], references: [id])

  @@index([ogrenciId, bitisTarihi])
  @@index([danismanKullaniciId, bitisTarihi])
  @@map("danisman_atama")
}

// ---------------------------------------------------------------------------
// 4. Çalışma grupları
// ---------------------------------------------------------------------------

/// Liste sabit kodlanmaz, proje yöneticisi yönetir. Silme yoktur:
/// kapanan grup aktif=false yapılır, geçmiş seçimler korunur.
model CalismaGrubu {
  id     Int     @id @default(autoincrement())
  ad     String  @unique @db.VarChar(150)
  siraNo Int     @map("sira_no")
  aktif  Boolean @default(true)

  ogrenciSecimleri  OgrenciCalismaGrubu[]
  faaliyetler       FaaliyetCalismaGrubu[]
  /// Bu grubun öğrenci yöneticileri (CALISMA_GRUBU_YONETICISI görev rolü).
  yoneticiGorevleri OgrenciGorevRolu[]
  /// Bu grupta mentörlük yapabilen kişiler.
  mentorlukleri     MentorlukCalismaGrubu[]
  /// Bu gruba katkı verebileceğini bildiren mezun/paydaş/mentörler.
  destekBildirenler KullaniciDestekGrubu[]

  talepler Talep[]

  @@map("calisma_grubu")
}

/// Temel Etkinlik ve Çalışma Grubu Etkinliği programlarının adı SABİTTİR ve
/// buradan yönetilir (çalışma_grubu ile aynı mantık: silme yok, pasife alma
/// var — geçmiş faaliyetler pasif programa bağlı kalmaya devam eder).
///
/// İl Etkinliği'nin karşılığı burada YOKTUR: il koordinatörü faaliyet adını
/// serbestçe girer, o yüzden referans listesi tutulmaz.
model TemelEtkinlikProgrami {
  id     Int                @id @default(autoincrement())
  ad     String             @unique @db.VarChar(200)
  grup   TemelEtkinlikGrubu
  siraNo Int                @map("sira_no")
  aktif  Boolean            @default(true)

  faaliyetler Faaliyet[]
  kazanimlar  KullaniciKazanim[]

  @@index([grup, siraNo])
  @@map("temel_etkinlik_programi")
}

/// Grubu öğrenci kendisi seçebilir; danışmanı, il koordinatörü ya da proje
/// yöneticisi de öğrencinin profilinden ekleyebilir. `ekleyenKullaniciId` NULL
/// ise seçim öğrencinin kendisine aittir — öğrenci profilinde kimin eklediğini
/// görebilsin diye tutuluyor, yetki kararında KULLANILMAZ.
model OgrenciCalismaGrubu {
  ogrenciId          Int      @map("ogrenci_id")
  calismaGrubuId     Int      @map("calisma_grubu_id")
  secimTarihi        DateTime @default(now()) @map("secim_tarihi") @db.Timestamptz(6)
  ekleyenKullaniciId Int?     @map("ekleyen_kullanici_id")

  ogrenci      Kullanici    @relation("GrupSecimOgrencisi", fields: [ogrenciId], references: [id])
  ekleyen      Kullanici?   @relation("GrupSecimEkleyen", fields: [ekleyenKullaniciId], references: [id])
  calismaGrubu CalismaGrubu @relation(fields: [calismaGrubuId], references: [id])

  @@id([ogrenciId, calismaGrubuId])
  @@map("ogrenci_calisma_grubu")
}

// ---------------------------------------------------------------------------
// 5. Öğrenci envanteri
// ---------------------------------------------------------------------------

/// Öğrencinin CV'si burada TEK kayıt olarak durur: yeni yükleme eskisinin
/// yerine geçer, geçmiş sürüm tutulmaz (istenen "güncel CV", arşiv değil).
/// Alanların hepsi birlikte dolar ya da birlikte boşalır; kısmi dolu bir satır
/// dosyası olmayan bir CV demek olurdu (ck_ogrenci_profil_cv, migration'da).
model OgrenciProfil {
  kullaniciId      Int       @id @map("kullanici_id")
  eposta           String?   @db.VarChar(150)
  telefon          String?   @db.VarChar(20)
  /// Öğrencinin yüklediği CV. Orijinal dosya adı yalnızca indirirken gösterilir;
  /// diskteki ad depolama katmanının ürettiği anahtardır (bkz. FaaliyetEk).
  cvDosyaAdi       String?   @map("cv_dosya_adi") @db.VarChar(255)
  cvDepolamaYolu   String?   @map("cv_depolama_yolu") @db.Text
  cvMimeTipi       String?   @map("cv_mime_tipi") @db.VarChar(100)
  cvBoyutBayt      BigInt?   @map("cv_boyut_bayt")
  cvYuklenmeTarihi DateTime? @map("cv_yuklenme_tarihi") @db.Timestamptz(6)

  /// Öğrencinin kendi girdiği mesleki bağlantıları. e-Okul'dan GELMEZ ve
  /// senkronda üzerine yazılmaz; e-posta ve telefonla aynı kategoridedir.
  ///
  /// Üçü AYRI sütundur, tek bir "bağlantılar" metni değil: ekran her birini
  /// kendi adıyla ve kendi ikonuyla gösteriyor, tek metinde tutulsaydı hangi
  /// adresin ne olduğu ayrıştırılamazdı. Adres doğrulaması (yalnızca
  /// http/https) uygulama katmanındadır — bkz. lib/ogrenci/iletisim-kurallar.ts.
  githubUrl      String? @map("github_url") @db.VarChar(200)
  kisiselSiteUrl String? @map("kisisel_site_url") @db.VarChar(200)
  linkedinUrl    String? @map("linkedin_url") @db.VarChar(200)

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id])

  @@map("ogrenci_profil")
}

/// Kullanıcının bir belgeye verdiği onay. Belge başına EN FAZLA BİR satır olur;
/// yeniden onay tarihi günceller, yeni satır açmaz.
///
/// Neden geçmiş tutulmuyor: onay bir DURUMDUR, "şu an geçerli metni kabul etmiş
/// mi" sorusuna cevap verir. Onayın kendisi ayrıca erişim kaydına yazıldığı için
/// (bkz. lib/yetki/log.ts) "kim ne zaman onayladı" izi zaten denetlenebilir
/// bir yerde duruyor — burada ikinci bir geçmiş tablosu tutmak aynı bilgiyi iki
/// kez saklamak olurdu.
///
/// Metnin sürümü SAKLANMAZ: tazelik, onay tarihi ile sistem_ayari'ndaki metnin
/// güncelleme tarihi karşılaştırılarak bulunur (bkz. lib/kvkk/kurallar.ts ·
/// onayiGerekiyorMu). Metin güncellenince onay kendiliğinden eskir.
model KullaniciOnayi {
  kullaniciId Int         @map("kullanici_id")
  belge       OnayBelgesi
  onayTarihi  DateTime    @default(now()) @map("onay_tarihi") @db.Timestamptz(6)

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id])

  @@id([kullaniciId, belge])
  @@map("kullanici_onayi")
}

/// İl, İlçe ve Okul Temsilcisi görev rolleri HİÇBİR ek veri görüntüleme yetkisi
/// vermez (bkz. references/permissions.md Bölüm 5). Eğitim-öğretim yılı
/// bazlıdır; dönem başına il/ilçe/okul tekilliği kısmi unique index ile korunur.
///
/// Her rolün kapsamı KENDİ sütununda durur (il / ilçe / kurum) ve o sütun rolüne
/// göre zorunludur (ck_ogrenci_gorev_kapsam). Kapsam öğrencinin kaydından
/// okunmaz: öğrenci okul değiştirdiğinde dönem içinde verilmiş görev, verildiği
/// yerde kalmalıdır.
model OgrenciGorevRolu {
  id                Int          @id @default(autoincrement())
  ogrenciId         Int          @map("ogrenci_id")
  rolKodu           GorevRolKodu @map("rol_kodu")
  egitimOgretimYili String       @map("egitim_ogretim_yili") @db.VarChar(9)
  ilKodu            String?      @map("il_kodu") @db.Char(2)
  /// ILCE_TEMSILCISI rolünün kapsamı.
  ilceKodu          String?      @map("ilce_kodu") @db.Char(4)
  kurumKodu         Int?         @map("kurum_kodu")
  /// CALISMA_GRUBU_YONETICISI rolünün kapsamı. Diğer rollerde NULL kalır.
  calismaGrubuId    Int?         @map("calisma_grubu_id")
  atayanKullaniciId Int          @map("atayan_kullanici_id")
  atamaTarihi       DateTime     @default(now()) @map("atama_tarihi") @db.Timestamptz(6)

  ogrenci      Kullanici     @relation("GorevSahibi", fields: [ogrenciId], references: [id])
  atayan       Kullanici     @relation("GorevAtayan", fields: [atayanKullaniciId], references: [id])
  il           Il?           @relation(fields: [ilKodu], references: [ilKodu])
  ilce         Ilce?         @relation(fields: [ilceKodu], references: [ilceKodu])
  kurum        Kurum?        @relation(fields: [kurumKodu], references: [kurumKodu])
  calismaGrubu CalismaGrubu? @relation(fields: [calismaGrubuId], references: [id])

  @@index([ogrenciId])
  @@map("ogrenci_gorev_rolu")
}

/// Kişinin kendi girdiği başarı/üretim kayıtları: GençTek dışı etkinlikler,
/// yaptığı ürünler, verdiği eğitimler ve derece aldığı yarışmalar.
///
/// SAHİBİ ÖĞRENCİ DE ÖĞRETMEN DE OLABİLİR — bu yüzden sütun `ogrenci_id` değil
/// `kullanici_id`'dir. Kaydın kime ait olduğu sütunda TUTULMAZ, sahibin aktif
/// rolünden okunur: kopyalanan bir "tip" alanı öğrenci mezun olduğunda ya da
/// öğretmen görev değiştirdiğinde eskir (aynı gerekçe `basvuru.katilimci_id`
/// için de geçerli). Ekranın etiketleri sahibe göre değişir ("verdiğim akran
/// eğitimleri" / "verdiğim eğitimler") ama kayıt aynı kayıttır.
///
/// KATILDIĞI GENÇTEK ETKİNLİKLERİ BURAYA YAZILMAZ. O liste `basvuru` + `faaliyet`
/// üzerinden türetilir (bkz. src/lib/kazanim/getir.ts); türetilebilen veriyi
/// kişinin eliyle ikinci kez girmesi hem yanlış hem de doğrulanamaz olurdu.
///
/// FAZ 2 NOTU: Rozet/katkı kategorileri netleşti (İl Temsilcisi, Okul
/// Temsilcisi, verdiği akran eğitimleri, çalışma grubu yöneticiliği /
/// organizasyon ekibi üyeliği, moderatörlük yaptığı etkinlikler, derece aldığı
/// yarışmalar). Rozet sistemi açıldığında yeni tablo AÇILMAZ: bu tablonun
/// `tip` alanı genişletilir — kategoriler mevcut değerlerle büyük ölçüde
/// örtüşüyor (bkz. references/domain-rules.md Bölüm 13).
model KullaniciKazanim {
  id                      Int            @id @default(autoincrement())
  kullaniciId             Int            @map("kullanici_id")
  tip                     KazanimTipi
  baslik                  String         @db.VarChar(250)
  aciklama                String?        @db.Text
  tarih                   DateTime?      @db.Timestamptz(6)
  baglantiUrl             String?        @map("baglanti_url") @db.Text
  /// Yarışma derecesi ("Türkiye 1.si", "Bölge 3.sü"). Serbest metindir: derece
  /// adlandırması yarışmadan yarışmaya değişiyor, sabit liste tutulmuyor.
  /// Yalnızca tip=YARISMA_DERECESI kayıtlarında anlamlıdır.
  derece                  String?        @db.VarChar(120)
  /// Etkinliği/yarışmayı düzenleyen kurum ya da kuruluş.
  duzenleyen              String?        @map("duzenleyen") @db.VarChar(200)
  /// Kayıt adı bilinen bir GençTek programından geliyorsa o programa işaret
  /// eder; "Diğer" seçilip serbest metin yazıldığında boş kalır.
  ///
  /// `baslik` bu durumda da DOLDURULUR (programın adı kopyalanır): program
  /// pasife alındığında ya da adı değiştiğinde öğrencinin geçmiş kaydı
  /// okunamaz hâle gelmemeli. Bağlantı, aynı programa ait kayıtları
  /// gruplayabilmek için tutulur.
  temelEtkinlikProgramiId Int?           @map("temel_etkinlik_programi_id")
  /// Yüz yüze / online / karma. Ürün kayıtlarında anlamsızdır, boş kalır.
  katilimBicimi           KatilimBicimi? @map("katilim_bicimi")
  /// Eğitimin/etkinliğin kime yönelik olduğu ("9. sınıflar", "veliler").
  /// Serbest metindir: sabit bir liste, akran eğitiminin çeşitliliğini taşımaz.
  hedefKitle              String?        @map("hedef_kitle") @db.VarChar(200)
  /// Ürünü geliştiren ekip. Yalnızca tip=URUN kayıtlarında anlamlıdır.
  gelistirenEkip          String?        @map("gelistiren_ekip") @db.VarChar(250)
  /// "Bu ürünü markette paylaş". Varsayılan false: paylaşım bir TERCİHTİR,
  /// açık gelmesi kullanıcının istemeden vitrine çıkması demek olurdu.
  /// GençTek Market (I maddesi) bu bayrağı okuyacak.
  markettePaylasilsin     Boolean        @default(false) @map("markette_paylasilsin")
  /// Market vitrin sayaçları (I). Yalnızca tip=URUN kayıtlarında anlamlıdır.
  ///
  /// Ürün detayı her açıldığında artar — SAHİBİ AÇTIĞINDA ARTMAZ, yoksa kişi
  /// kendi sayfasını yenileyerek sayacı şişirebilirdi. Tekilleştirme yoktur:
  /// aynı kişi iki kez bakarsa iki sayılır (vitrin sayacı, denetim kaydı
  /// değil — kim neye baktı bilgisi erişim logunda).
  goruntulenmeSayisi      Int            @default(0) @map("goruntulenme_sayisi")
  /// "İNDİRİLME" DEĞİL, bağlantıya gidilme sayısı — ve bu bilinçli.
  ///
  /// İstek "indirilme sayıları görüntülenecek" diyor ama ürünlerde dosya
  /// yükleme kapsam dışı ("şimdilik sadece tanıtım yapsınlar" · D5). İndirilecek
  /// bir dosya olmadığı için sayılabilecek en yakın olay, kullanıcının ürünün
  /// deposuna/canlı sürümüne gitmesidir. Dosya yükleme açılırsa gerçek indirme
  /// AYRI bir sütun olur; bu sayaç anlamını korur (→ S22).
  baglantiTiklamasi       Int            @default(0) @map("baglanti_tiklamasi")
  /// Kaydın girildiği an. Kullanıcının girdiği `tarih` boş olabildiği için
  /// listeleme sırası buradan kurulur.
  olusturmaTarihi         DateTime       @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)

  kullanici             Kullanici              @relation(fields: [kullaniciId], references: [id])
  temelEtkinlikProgrami TemelEtkinlikProgrami? @relation(fields: [temelEtkinlikProgramiId], references: [id])
  ekler                 KazanimEk[]
  baglantilar           KazanimBaglanti[]

  @@index([kullaniciId])
  @@map("kullanici_kazanim")
}

/// Kazanım kaydının bağlantıları — ürünün deposu, canlı adresi, tanıtım
/// videosu ayrı ayrı olabilir. Kazanım tablosundaki tek `baglantiUrl` alanı
/// KALDIRILMADI: dolu kayıtlar var ve diğer tipler onu kullanmaya devam ediyor.
model KazanimBaglanti {
  id        Int     @id @default(autoincrement())
  kazanimId Int     @map("kazanim_id")
  adres     String  @db.VarChar(500)
  /// Bağlantının ne olduğu ("kaynak kod", "canlı sürüm").
  etiket    String? @db.VarChar(100)
  siraNo    Int     @default(0) @map("sira_no")

  kazanim KullaniciKazanim @relation(fields: [kazanimId], references: [id], onDelete: Cascade)

  @@index([kazanimId])
  @@map("kazanim_baglanti")
}

/// Kazanım kaydının destekleyici belgeleri (etkinlik fotoğrafı, katılım
/// belgesi vb.). Depolama deseni `faaliyet_ek` ile aynıdır.
///
/// Soft-delete YOKTUR (faaliyet_ek'ten ayrıldığı tek nokta): kazanım kaydının
/// kendisi de kalıcı siliniyor, eki soft-delete tutmak tutarsız bir çift
/// üretirdi. Silme erisim_logu'na yazılır.
model KazanimEk {
  id             Int      @id @default(autoincrement())
  kazanimId      Int      @map("kazanim_id")
  dosyaAdi       String   @map("dosya_adi") @db.VarChar(255)
  /// Depolama soyutlamasının döndürdüğü anahtar — dosya sistemi yolu değil.
  depolamaYolu   String   @map("depolama_yolu") @db.Text
  mimeTipi       String   @map("mime_tipi") @db.VarChar(100)
  boyutBayt      BigInt   @map("boyut_bayt")
  yuklenmeTarihi DateTime @default(now()) @map("yuklenme_tarihi") @db.Timestamptz(6)

  kazanim KullaniciKazanim @relation(fields: [kazanimId], references: [id], onDelete: Cascade)

  @@index([kazanimId])
  @@map("kazanim_ek")
}

/// "Rotam" — öğrencinin hedefleri, yapmak istedikleri.
///
/// KAZANIMDAN FARKI, iki alanın da metin tutuyor olmasına rağmen esastır:
/// kazanım "yaptım" beyanıdır, geçmişe bakar ve danışman/koordinatör görür;
/// hedef "yapmak istiyorum" beyanıdır, geleceğe bakar ve KİŞİYE ÖZELDİR.
/// İkisini tek tabloda birleştirmek, birinin görünürlük kuralını öbürüne
/// bulaştırırdı.
///
/// Serbest metin yerine LİSTE seçildi; gerekçesi göç dosyasında.
model KullaniciHedefi {
  id               Int         @id @default(autoincrement())
  kullaniciId      Int         @map("kullanici_id")
  baslik           String      @db.VarChar(250)
  aciklama         String?     @db.Text
  durum            HedefDurumu @default(PLANLANDI)
  /// Yalnızca tarih (saat yok): "bu yıl içinde" ölçeğinde bir niyet, randevu
  /// değil. Saat tutulsaydı dilim kayması hedefi bir gün oynatabilirdi.
  hedefTarihi      DateTime?   @map("hedef_tarihi") @db.Date
  /// Tamamlanma ANI. `durum`dan türetilemez — durum TAMAMLANDI'ya çevrildiğinde
  /// bunun ne zaman olduğunu başka hiçbir alan tutmuyor.
  tamamlanmaTarihi DateTime?   @map("tamamlanma_tarihi") @db.Timestamptz(6)

  olusturmaTarihi  DateTime @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi DateTime @default(now()) @map("guncelleme_tarihi") @db.Timestamptz(6)

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)

  @@index([kullaniciId])
  @@map("kullanici_hedefi")
}

// ---------------------------------------------------------------------------
// 5b. Algoritmam — öz değerlendirme envanterleri (E)
// ---------------------------------------------------------------------------

/// ENVANTER TANIMLARI BURADA DEĞİL, KODDA: madde metinleri, ölçek ve puanlama
/// anahtarı `lib/envanter/tanimlar.ts` içinde durur (KAZANIM_TANIMLARI ve
/// BELGE_TANIMLARI ile aynı desen). Gerekçe göç dosyasında; kısası: tanım
/// sürümlenmeli, editörü istenmedi, telifli metin veri dışa aktarımına
/// karışmamalı.
///
/// Veritabanında yalnızca kişiye ait olan tutulur: hangi envanteri ne zaman
/// çözdüğü ve verdiği cevaplar.
model EnvanterUygulamasi {
  id           Int    @id @default(autoincrement())
  kullaniciId  Int    @map("kullanici_id")
  /// Kod tarafındaki tanımın kodu. Yabancı anahtarı YOKTUR — karşılığı
  /// veritabanında değil. Tanımı olmayan koda kayıt açılmaz (uygulama katmanı).
  envanterKodu String @map("envanter_kodu") @db.VarChar(60)
  /// Cevapların hangi madde listesine göre verildiği. Tanım değişip sürüm
  /// artınca eski uygulamalar PUANLANMAZ; yeni anahtarla eski cevabı puanlamak
  /// sessizce yanlış bir sonuç üretirdi.
  surum        Int

  durum EnvanterDurumu @default(SURUYOR)

  baslamaTarihi    DateTime  @default(now()) @map("baslama_tarihi") @db.Timestamptz(6)
  /// Yalnızca TAMAMLANDI iken doludur; `durum`dan türetilemez.
  tamamlanmaTarihi DateTime? @map("tamamlanma_tarihi") @db.Timestamptz(6)

  kullanici Kullanici        @relation(fields: [kullaniciId], references: [id], onDelete: Cascade)
  cevaplar  EnvanterCevabi[]

  @@index([kullaniciId, envanterKodu])
  @@map("envanter_uygulamasi")
}

/// Tek maddeye verilen tek cevap.
///
/// JSON değil SATIR: puanlama madde madde çalışıyor (ters puanlanan maddeler
/// var) ve eksik madde JSON'da sessizce geçerken burada benzersizlik kısıtına
/// takılır.
model EnvanterCevabi {
  id         Int    @id @default(autoincrement())
  uygulamaId Int    @map("uygulama_id")
  maddeKodu  String @map("madde_kodu") @db.VarChar(80)
  /// Likert derecesi. Geçerli aralık ENVANTERE GÖRE değişir ve doğrulaması
  /// tanıma bakılarak yapılır; sütun kısıtı yalnızca kaba bir üst sınırdır.
  deger      Int    @db.SmallInt

  uygulama EnvanterUygulamasi @relation(fields: [uygulamaId], references: [id], onDelete: Cascade)

  @@unique([uygulamaId, maddeKodu], map: "envanter_cevabi_tekil")
  @@index([uygulamaId])
  @@map("envanter_cevabi")
}

// ---------------------------------------------------------------------------
// 6. Faaliyet, dosya/görsel ve yorum
// ---------------------------------------------------------------------------

/// Kapsam=ULUSAL ve düzenleyen il koordinatörü ise onayDurumu=BEKLIYOR ile
/// oluşur ve onaylanana kadar öğrencilere GÖRÜNMEZ. Diğer durumlarda
/// ONAY_GEREKMEZ. Danışman öğretmen yalnızca OKUL kapsamı açabilir.
model Faaliyet {
  id                      Int                @id @default(autoincrement())
  ad                      String             @db.VarChar(250)
  aciklama                String             @db.Text
  tarih                   DateTime           @db.Timestamptz(6)
  /// Çok günlü faaliyetlerin bitiş tarihi. NULL = tek günlük.
  ///
  /// Ayrı bir "kaç gün sürer" sayısı TUTULMAZ: süre, iki tarihten hesaplanır.
  /// Sayı tutulsaydı tarih değiştiğinde güncellenmesi unutulur ve ekranda
  /// tarihle çelişen bir süre görünürdü.
  bitisTarihi             DateTime?          @map("bitis_tarihi") @db.Timestamptz(6)
  /// Yüz yüze / online / karma. Kazanım kayıtlarında zaten vardı; faaliyette
  /// yoktu — faaliyeti AÇAN kişi aynı bilgiyi giremiyordu.
  ///
  /// NULL kabul eder ve varsayılan verilmez: "yüz yüze" varsaymak, online
  /// yapılmış geçmiş faaliyetleri sessizce yanlış etiketlerdi.
  katilimBicimi           KatilimBicimi?     @map("katilim_bicimi")
  /// Faaliyetin kime yönelik olduğu ("9. sınıflar", "veliler", "öğretmenler").
  /// Serbest metin: sabit bir liste bu çeşitliliği taşımıyor.
  hedefKitle              String?            @map("hedef_kitle") @db.VarChar(200)
  kapsam                  Kapsam
  /// Etkinliğin niteliği. Kapsam'dan BAĞIMSIZDIR: kapsam kimin
  /// başvurabileceğini, kategori etkinliğin ne olduğunu söyler.
  etkinlikKategorisi      EtkinlikKategorisi @map("etkinlik_kategorisi")
  /// Yalnızca TEMEL_ETKINLIK ve CALISMA_GRUBU_ETKINLIGI kategorilerinde dolu:
  /// bu iki kategoride faaliyetin adı sabit program listesinden gelir.
  /// IL_ETKINLIGI'nde boştur, çünkü ad alanı zaten temayı taşır.
  temelEtkinlikProgramiId Int?               @map("temel_etkinlik_programi_id")
  /// Kapsam=OKUL ise dolu.
  kurumKodu               Int?               @map("kurum_kodu")
  /// Kapsam=IL ise dolu.
  ilKodu                  String?            @map("il_kodu") @db.Char(2)
  ilceKodu                String?            @map("ilce_kodu") @db.Char(4)
  kontenjan               Int
  duzenleyenKullaniciId   Int                @map("duzenleyen_kullanici_id")
  duzenleyenBirim         String             @map("duzenleyen_birim") @db.VarChar(200)
  onayDurumu              OnayDurumu         @default(ONAY_GEREKMEZ) @map("onay_durumu")
  onaylayanKullaniciId    Int?               @map("onaylayan_kullanici_id")
  onayTarihi              DateTime?          @map("onay_tarihi") @db.Timestamptz(6)
  basvuruBaslangic        DateTime           @map("basvuru_baslangic") @db.Timestamptz(6)
  basvuruBitis            DateTime           @map("basvuru_bitis") @db.Timestamptz(6)
  olusturmaTarihi         DateTime           @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  /// İptal edilen faaliyet SİLİNMEZ: listelerde "İptal edildi" etiketiyle
  /// görünmeye devam eder, yeni başvuru/yorum/dosya kabul etmez.
  durum                   FaaliyetDurumu     @default(AKTIF)
  iptalGerekcesi          String?            @map("iptal_gerekcesi") @db.Text
  iptalEdenKullaniciId    Int?               @map("iptal_eden_kullanici_id")
  iptalTarihi             DateTime?          @map("iptal_tarihi") @db.Timestamptz(6)
  /// Faaliyetin tanıtıcı görseli. Ayrı bir dosya değil, eklerden BİRİNE işaret
  /// eder: aynı görsel hem kapak hem ek olarak iki kez yüklenmesin.
  kapakEkId               Int?               @unique @map("kapak_ek_id")

  duzenleyen Kullanici   @relation("FaaliyetDuzenleyen", fields: [duzenleyenKullaniciId], references: [id])
  onaylayan  Kullanici?  @relation("FaaliyetOnaylayan", fields: [onaylayanKullaniciId], references: [id])
  iptalEden  Kullanici?  @relation("FaaliyetIptalEden", fields: [iptalEdenKullaniciId], references: [id])
  kurum      Kurum?      @relation(fields: [kurumKodu], references: [kurumKodu])
  il         Il?         @relation(fields: [ilKodu], references: [ilKodu])
  ilce       Ilce?       @relation(fields: [ilceKodu], references: [ilceKodu])
  kapakEk    FaaliyetEk? @relation("FaaliyetKapak", fields: [kapakEkId], references: [id], onDelete: SetNull)

  temelEtkinlikProgrami TemelEtkinlikProgrami? @relation(fields: [temelEtkinlikProgramiId], references: [id])

  calismaGruplari FaaliyetCalismaGrubu[]
  ekler           FaaliyetEk[]
  rapor           FaaliyetRaporu?
  yorumlar        Yorum[]
  basvurular      Basvuru[]
  paydaslar       FaaliyetPaydas[]
  belgeler        FaaliyetBelgesi[]

  @@index([kapsam, onayDurumu])
  @@index([etkinlikKategorisi])
  @@index([temelEtkinlikProgramiId])
  @@index([kurumKodu])
  @@index([ilKodu])
  @@index([duzenleyenKullaniciId])
  @@map("faaliyet")
}

/// Yalnızca etiket/filtre amaçlıdır, başvuruyu KISITLAMAZ.
model FaaliyetCalismaGrubu {
  faaliyetId     Int @map("faaliyet_id")
  calismaGrubuId Int @map("calisma_grubu_id")

  faaliyet     Faaliyet     @relation(fields: [faaliyetId], references: [id], onDelete: Cascade)
  calismaGrubu CalismaGrubu @relation(fields: [calismaGrubuId], references: [id])

  @@id([faaliyetId, calismaGrubuId])
  @@map("faaliyet_calisma_grubu")
}

/// Ek yükleme yetkisi YALNIZCA faaliyeti açan kullanıcıdadır; rol kontrolü tek
/// başına yeterli değildir (aynı rolden başka biri başkasının faaliyetine ek
/// ekleyemez). Silme soft-delete'tir, log gereği kayıt korunur.
/// Biten faaliyetin raporu — analiz isteği Bölüm 4.
///
/// SAYILAR BURADA TUTULMAZ: kaç kişi katıldığı başvurulardan her görüntülemede
/// hesaplanır. Rapora kopyalansaydı bir başvuru sonradan güncellendiğinde rapor
/// sessizce yanlış olurdu. Bu tablo yalnızca İNSANIN YAZDIĞINI taşır.
model FaaliyetRaporu {
  faaliyetId       Int      @id @map("faaliyet_id")
  degerlendirme    String   @db.Text
  /// Hedeflenen kazanımlar gerçekleşti mi, aksayan ne oldu.
  kazanimlar       String?  @db.Text
  yazanKullaniciId Int      @map("yazan_kullanici_id")
  olusturmaTarihi  DateTime @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi DateTime @default(now()) @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  faaliyet Faaliyet  @relation(fields: [faaliyetId], references: [id], onDelete: Cascade)
  yazan    Kullanici @relation("RaporYazan", fields: [yazanKullaniciId], references: [id])

  @@index([yazanKullaniciId])
  @@map("faaliyet_raporu")
}

model FaaliyetEk {
  id                  Int       @id @default(autoincrement())
  faaliyetId          Int       @map("faaliyet_id")
  yukleyenKullaniciId Int       @map("yukleyen_kullanici_id")
  dosyaAdi            String    @map("dosya_adi") @db.VarChar(255)
  /// Depolama soyutlamasının döndürdüğü anahtar — dosya sistemi yolu değil.
  depolamaYolu        String    @map("depolama_yolu") @db.Text
  mimeTipi            String    @map("mime_tipi") @db.VarChar(100)
  boyutBayt           BigInt    @map("boyut_bayt")
  yuklenmeTarihi      DateTime  @default(now()) @map("yuklenme_tarihi") @db.Timestamptz(6)
  silindiMi           Boolean   @default(false) @map("silindi_mi")
  silenKullaniciId    Int?      @map("silen_kullanici_id")
  silinmeTarihi       DateTime? @map("silinme_tarihi") @db.Timestamptz(6)

  faaliyet     Faaliyet   @relation(fields: [faaliyetId], references: [id], onDelete: Cascade)
  yukleyen     Kullanici  @relation("EkYukleyen", fields: [yukleyenKullaniciId], references: [id])
  silen        Kullanici? @relation("EkSilen", fields: [silenKullaniciId], references: [id])
  kapagiOldugu Faaliyet?  @relation("FaaliyetKapak")

  @@index([faaliyetId, silindiMi])
  @@map("faaliyet_ek")
}

/// Görünürlüğü bağlı olduğu faaliyetin kapsamıyla BİREBİR aynıdır — ayrı bir
/// izin sistemi değildir. Silme soft-delete: içerik kullanıcıya gösterilmez
/// ama kayıt ve silen bilgisi log için korunur. Yanıt zinciri kopmaz.
model Yorum {
  id               Int       @id @default(autoincrement())
  faaliyetId       Int       @map("faaliyet_id")
  yazanKullaniciId Int       @map("yazan_kullanici_id")
  /// Yanıt zinciri: silinen üst yorum "silindi" görünür, alt yorumlar kalır.
  ustYorumId       Int?      @map("ust_yorum_id")
  icerik           String    @db.Text
  olusturmaTarihi  DateTime  @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  silindiMi        Boolean   @default(false) @map("silindi_mi")
  silenKullaniciId Int?      @map("silen_kullanici_id")
  silinmeTarihi    DateTime? @map("silinme_tarihi") @db.Timestamptz(6)

  faaliyet    Faaliyet   @relation(fields: [faaliyetId], references: [id], onDelete: Cascade)
  yazan       Kullanici  @relation("YorumYazan", fields: [yazanKullaniciId], references: [id])
  silen       Kullanici? @relation("YorumSilen", fields: [silenKullaniciId], references: [id])
  ustYorum    Yorum?     @relation("YorumZinciri", fields: [ustYorumId], references: [id])
  altYorumlar Yorum[]    @relation("YorumZinciri")

  @@index([faaliyetId, olusturmaTarihi])
  @@map("yorum")
}

// ---------------------------------------------------------------------------
// 7. Başvuru
// ---------------------------------------------------------------------------

/// Faaliyete katılım başvurusu. Gerekçe zorunludur; aynı faaliyete aktif ikinci
/// başvuru kısmi unique index ile engellenir, geri çekilmiş başvurular kısıt
/// dışıdır (kontenjan dolmadıysa yeniden başvurulur).
///
/// KATILIMCI ÖĞRENCİ OLMAK ZORUNDA DEĞİLDİR: öğretmenler de faaliyetlere
/// başvurur (alan adı bu yüzden `ogrenciId` değil `katilimciId`). Katılımcının
/// öğrenci mi öğretmen mi olduğu ayrı bir sütunda tutulmaz, kişinin aktif
/// rolünden okunur — rol zaten tek doğru kaynaktır ve kopyalanan bir tip alanı
/// öğrenci mezun olduğunda ya da öğretmen görev değiştirdiğinde eskir.
model Basvuru {
  id                       Int           @id @default(autoincrement())
  faaliyetId               Int           @map("faaliyet_id")
  /// Faaliyete KATILACAK kişi. Başvuruyu yapan kişi değildir: danışman
  /// öğretmen öğrencisi adına başvurduğunda burada öğrenci durur.
  katilimciId              Int           @map("katilimci_id")
  /// Başvuruyu katılımcının YERİNE yapan kişi (danışman öğretmen ya da il
  /// koordinatörü). NULL ise başvuruyu katılımcının kendisi yapmıştır.
  ///
  /// Ayrı bir "başvuru tipi" enum'u tutulmaz: bu alanın dolu olması zaten
  /// vekaleten başvuru demektir ve kimin yaptığını da söyler.
  adinaBasvuranKullaniciId Int?          @map("adina_basvuran_kullanici_id")
  gerekce                  String        @db.Text
  durum                    BasvuruDurumu @default(BEKLIYOR)
  basvuruTarihi            DateTime      @default(now()) @map("basvuru_tarihi") @db.Timestamptz(6)
  geriCekmeTarihi          DateTime?     @map("geri_cekme_tarihi") @db.Timestamptz(6)
  degerlendirenKullaniciId Int?          @map("degerlendiren_kullanici_id")
  degerlendirmeTarihi      DateTime?     @map("degerlendirme_tarihi") @db.Timestamptz(6)

  /// İl DIŞI başvuruda, öğrencinin KENDİ ilinin koordinatörünün kararı.
  ///
  /// İkinci onay ayrıca tutulmaz: faaliyeti düzenleyenin yaptığı değerlendirme
  /// (durum alanı) zaten etkinliğin yapıldığı ilin kararıdır. Aynı kararı iki
  /// sütunda tutmak, ikisini senkron tutma zorunluluğu doğururdu.
  ///
  /// ONAY_GEREKMEZ: başvuru kendi ili içinde ya da bu akıştan önce yapılmış.
  kaynakIlOnayDurumu           OnayDurumu @default(ONAY_GEREKMEZ) @map("kaynak_il_onay_durumu")
  kaynakIlOnaylayanKullaniciId Int?       @map("kaynak_il_onaylayan_kullanici_id")
  kaynakIlOnayTarihi           DateTime?  @map("kaynak_il_onay_tarihi") @db.Timestamptz(6)
  kaynakIlRetGerekcesi         String?    @map("kaynak_il_ret_gerekcesi") @db.Text

  /// ETKİNLİK SONRASI YOKLAMA (12 Ağustos 2026).
  ///
  /// NULL = yoklama alınmadı, true = geldi, false = gelmedi. Üç hâl de ayrı
  /// bilgi: "gelmedi" ile "sorulmadı" aynı şey değildir ve boolean varsayılanı
  /// (false) herkesi katılmamış saymak olurdu.
  ///
  /// `durum` ile karıştırılmamalı: SECILDI "katılabilir" demektir, bu alan
  /// "katıldı" demektir. Seçilmiş olmak katılım sayılırken, gelmeyen öğrencinin
  /// profiline de etkinlik düşüyordu (bkz. lib/kazanim/katilim-kurallar.ts).
  katildiMi              Boolean?  @map("katildi_mi")
  /// Yoklamayı işaretleyen yetkili — beyanın sahibi belli olsun.
  yoklamaAlanKullaniciId Int?      @map("yoklama_alan_kullanici_id")
  yoklamaTarihi          DateTime? @map("yoklama_tarihi") @db.Timestamptz(6)

  faaliyet          Faaliyet   @relation(fields: [faaliyetId], references: [id], onDelete: Cascade)
  katilimci         Kullanici  @relation("BasvuruKatilimcisi", fields: [katilimciId], references: [id])
  adinaBasvuran     Kullanici? @relation("BasvuruAdinaBasvuran", fields: [adinaBasvuranKullaniciId], references: [id])
  degerlendiren     Kullanici? @relation("BasvuruDegerlendiren", fields: [degerlendirenKullaniciId], references: [id])
  kaynakIlOnaylayan Kullanici? @relation("BasvuruKaynakIlOnaylayan", fields: [kaynakIlOnaylayanKullaniciId], references: [id])
  yoklamaAlan       Kullanici? @relation("BasvuruYoklamaAlan", fields: [yoklamaAlanKullaniciId], references: [id])

  @@index([faaliyetId, durum])
  @@index([katilimciId])
  @@index([kaynakIlOnayDurumu])
  @@map("basvuru")
}

/// Bir kişiye bir etkinlikten belge ÜRETİLDİĞİNİN kaydı.
///
/// NE TUTMAZ: belgenin metnini, adı, imzayı. Belge içeriği eskisi gibi her
/// istekte faaliyet kayıtlarından üretilmeye devam ediyor (bkz.
/// lib/belge/kurallar.ts) — metin saklansaydı faaliyetin adı düzeltildiğinde
/// basılmış belgeler eski adı göstermeye devam ederdi.
///
/// NEDEN YİNE DE TABLO: "ismine belge oluşturulan öğrencinin profiline
/// katıldığı etkinlik düşsün" kuralı (7 Ağustos 2026) belge üretimini kişi
/// hakkında KALICI bir olguya çevirdi. Bu bilgi daha önce yalnızca erişim
/// kaydının serbest metnindeydi; erişim kayıtları KVKK saklama süresiyle
/// siliniyor (scripts/veri-saklama.ts), yani öğrencinin katılım geçmişi
/// bakım işi çalıştığında sessizce boşalırdı.
///
/// Yalnızca SİSTEMDE KAYDI OLAN kişi için satır açılır. Belgeler ekranındaki
/// "listede olmayan biri için" formu serbest metin ad alır (konuşmacı, destek
/// veren kurum); onların profili olmadığı için düşecekleri bir yer de yok.
model FaaliyetBelgesi {
  id                Int               @id @default(autoincrement())
  faaliyetId        Int               @map("faaliyet_id")
  /// Belgenin sahibi. Faaliyetin SEÇİLMİŞ katılımcısı olduğu üretim anında
  /// doğrulanır; adres çubuğuna elle kimlik yazan biri katılımcı olmayan
  /// birine belge bastıramaz.
  katilimciId       Int               @map("katilimci_id")
  tur               FaaliyetBelgeTuru
  uretimTarihi      DateTime          @default(now()) @map("uretim_tarihi") @db.Timestamptz(6)
  /// Belgeyi üreten yetkili. Erişim kaydı silinse de "bu belgeyi kim bastı"
  /// sorusunun cevabı burada kalır.
  uretenKullaniciId Int               @map("ureten_kullanici_id")

  faaliyet  Faaliyet  @relation(fields: [faaliyetId], references: [id], onDelete: Cascade)
  katilimci Kullanici @relation("BelgeSahibi", fields: [katilimciId], references: [id])
  ureten    Kullanici @relation("BelgeUreten", fields: [uretenKullaniciId], references: [id])

  /// Aynı belgeyi ikinci kez yazdırmak yeni bir satır AÇMAZ: kayıt "kaç kez
  /// basıldı" değil "üretildi mi" sorusunu cevaplıyor. Yazıcı sıkıştığı için
  /// üç kez basılan belge, öğrencinin profiline üç katılım düşürmemeli.
  @@unique([faaliyetId, katilimciId, tur])
  @@index([katilimciId])
  @@map("faaliyet_belgesi")
}

// ---------------------------------------------------------------------------
// 7b. İl bazlı paydaş envanteri
// ---------------------------------------------------------------------------

/// GençTek faaliyetlerinde iş birliği yapılabilecek kurum ve kuruluşlar.
///
/// Kayıt İLE bağlıdır ve ilin koordinatörü tarafından yönetilir: paydaş
/// listesinin değeri yerelliğindedir, merkezden tutulan bir kurum listesi
/// il koordinatörünün gerçekten arayabileceği kişiyi göstermez.
///
/// SİLME YOKTUR: iş birliği biten paydaş `aktif=false` yapılır. Geçmiş
/// faaliyetlerin paydaş bağlantısı bozulmamalı.
model Paydas {
  id                 Int        @id @default(autoincrement())
  ilKodu             String     @map("il_kodu") @db.Char(2)
  ad                 String     @db.VarChar(250)
  tur                PaydasTuru
  /// İrtibat kişisi ve unvanı; kurumun santralı yerine gerçek muhatap.
  yetkiliKisi        String?    @map("yetkili_kisi") @db.VarChar(150)
  eposta             String?    @db.VarChar(150)
  telefon            String?    @db.VarChar(20)
  adres              String?    @db.Text
  /// İş birliği alanı / potansiyeli — serbest metin. Sabit liste tutulmaz:
  /// bir üniversitenin sunduğu imkân ile bir yazılım firmasınınki aynı
  /// kategorilere sığmıyor.
  isBirligiAlani     String     @map("is_birligi_alani") @db.Text
  notlar             String?    @db.Text
  aktif              Boolean    @default(true)
  ekleyenKullaniciId Int        @map("ekleyen_kullanici_id")
  olusturmaTarihi    DateTime   @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  guncellemeTarihi   DateTime   @default(now()) @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  il      Il        @relation(fields: [ilKodu], references: [ilKodu])
  ekleyen Kullanici @relation("PaydasEkleyen", fields: [ekleyenKullaniciId], references: [id])

  faaliyetler         FaaliyetPaydas[]
  /// Bu kurumu temsilen sisteme giriş isteyen kişiler. Aynı kurumdan birden
  /// fazla temsilci olabilir; kurum kaydı kişiden bağımsız yaşar.
  temsilciBasvurulari DisKullaniciBasvurusu[]

  @@index([ilKodu, aktif])
  @@index([tur])
  @@map("paydas")
}

/// Faaliyetin paydaş bilgisi (faaliyet sonuç alanlarındaki "paydaş (varsa)").
/// Bağlantıyı faaliyeti açan kullanıcı kurar; paydaşın ili faaliyetin iliyle
/// aynı olmak ZORUNDA DEĞİLDİR — ulusal faaliyete başka ilden bir üniversite
/// destek verebilir.
model FaaliyetPaydas {
  faaliyetId   Int      @map("faaliyet_id")
  paydasId     Int      @map("paydas_id")
  /// Bu faaliyetteki katkısı ("mekân", "eğitmen", "ödül desteği" gibi).
  katkisi      String?  @db.VarChar(250)
  eklemeTarihi DateTime @default(now()) @map("ekleme_tarihi") @db.Timestamptz(6)

  faaliyet Faaliyet @relation(fields: [faaliyetId], references: [id], onDelete: Cascade)
  paydas   Paydas   @relation(fields: [paydasId], references: [id])

  @@id([faaliyetId, paydasId])
  @@index([paydasId])
  @@map("faaliyet_paydas")
}

// ---------------------------------------------------------------------------
// 8. Log ve bildirim
// ---------------------------------------------------------------------------

/// Her veri görüntüleme ve değiştirme işlemi loglanır. Yorum ve dosya silme
/// işlemleri de buraya yazılır; ayrı bir içerik log tablosu yoktur.
model Erisimlogu {
  id          Int         @id @default(autoincrement())
  kullaniciId Int         @map("kullanici_id")
  islem       LogIslemi
  hedefTip    LogHedefTip @map("hedef_tip")
  hedefId     String      @map("hedef_id") @db.VarChar(64)
  tarih       DateTime    @default(now()) @db.Timestamptz(6)
  ipAdresi    String?     @map("ip_adresi") @db.VarChar(64)
  detay       String?     @db.Text

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id])

  @@index([kullaniciId, tarih])
  @@index([hedefTip, hedefId])
  @@map("erisim_logu")
}

model Bildirim {
  id              Int                @id @default(autoincrement())
  kullaniciId     Int                @map("kullanici_id")
  tip             String             @db.VarChar(60)
  baslik          String             @db.VarChar(200)
  icerik          String             @db.Text
  /// Bildirimin işaret ettiği kayıt — "etkinliğe git" düğmesinin hedefi
  /// (10 Ağustos 2026).
  ///
  /// METİNDEN TÜRETİLEMEZ: gövdede etkinliğin ADI geçiyor, kimliği değil ve
  /// aynı adı taşıyan iki etkinlik olabilir. Ada bakarak bağlantı kurmak,
  /// kullanıcıyı sessizce yanlış kayda götürürdü.
  ///
  /// İKİ ALAN, tek `faaliyetId` değil: yazışma ve dış başvuru bildirimleri de
  /// bir gün hedef isteyecek. Tür bilinmeden id'nin hangi tabloya ait olduğu
  /// belli olmaz.
  ///
  /// NULL OLAĞANDIR: danışman değişikliği gibi bildirimlerin gidilecek bir
  /// kaydı yok; bu alanlar eklenmeden önce yazılmış bildirimlerde de boştur.
  hedefTip        BildirimHedefTipi? @map("hedef_tip")
  hedefId         Int?               @map("hedef_id")
  okunduMu        Boolean            @default(false) @map("okundu_mu")
  gonderimKanali  GonderimKanali     @default(SISTEM) @map("gonderim_kanali")
  olusturmaTarihi DateTime           @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  epostaDurumu    GonderimDurumu     @default(GEREKMIYOR) @map("eposta_durumu")
  /// Gönderim başarısızsa sağlayıcının verdiği gerekçe. Sessiz başarısızlık,
  /// hiç göndermemekten kötüdür: kimse eksiği fark etmez.
  epostaHatasi    String?            @map("eposta_hatasi") @db.Text
  /// SMS kopyası e-postadan BAĞIMSIZ izlenir: biri gitmiş öbürü gitmemiş
  /// olabilir ve "bildirim ulaşmadı" şikâyetinde hangi kanalın düştüğü
  /// bilinmeden bakılacak yer yoktur.
  smsDurumu       GonderimDurumu     @default(GEREKMIYOR) @map("sms_durumu")
  smsHatasi       String?            @map("sms_hatasi") @db.Text

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id])

  @@index([kullaniciId, okunduMu])
  @@map("bildirim")
}

/// Bildirimin işaret ettiği kaydın türü.
///
/// `LogHedefTip` PAYLAŞILMADI: o enum erişim kaydının sözlüğüdür ve
/// "görüntülenen her şeyi" sayar (PROFIL, CV, OGRENCI_LISTESI…). Bildirimin
/// hedefi ise GİDİLEBİLİR bir ekran olmak zorunda. Paylaşılsaydı, hiçbir
/// zaman bildirim hedefi olmayacak onlarca değeri her eşlemede ele almak
/// gerekirdi.
enum BildirimHedefTipi {
  FAALIYET
  /// Ekip sohbeti (13 Ağustos 2026). Bildirim panelde "Ekibe git" düğmesine
  /// dönüşür; ekibe iki ayrı kapıdan girildiği için (üyede Panel kartı,
  /// koordinatörde Yönetim Paneli kartı) doğrudan bağlantı gerekli.
  EKIP
}

/// Bildirim metinleri koda gömülmez, buradan yönetilir. Kod sabittir ve
/// uygulamadan gelir (bkz. src/lib/bildirim/sablon.ts); Yönetim ekranından
/// yalnızca konu, gövde ve aktiflik değiştirilir — yeni kod eklemek koda
/// dokunmayı gerektirir, çünkü şablonu tetikleyen olay kodda yaşar.
model BildirimSablonu {
  id           Int     @id @default(autoincrement())
  kod          String  @unique @db.VarChar(60)
  konu         String  @db.VarChar(200)
  govdeSablonu String  @map("govde_sablonu") @db.Text
  /// Şablonun hangi olayda gittiği. Kod adı ("BASVURU_SONUCU") tek başına
  /// yeterince anlatıcı değil; yönetim ekranında bu metin gösterilir.
  aciklama     String? @db.Text
  aktif        Boolean @default(true)

  @@map("bildirim_sablonu")
}

// ---------------------------------------------------------------------------
// 9. Sistem ayarları
// ---------------------------------------------------------------------------

/// Proje yöneticisi tarafından yapılandırılabilen değerler (dosya boyut
/// sınırları, izinli dosya tipleri gibi). Koda gömülmez.
///
/// Öğrenci başına çalışma grubu üst sınırı BURADA TUTULMAZ: sınır kaldırıldı,
/// öğrenci istediği kadar grup seçer.
model SistemAyari {
  anahtar          String   @id @db.VarChar(80)
  deger            String   @db.Text
  aciklama         String?  @db.Text
  guncellemeTarihi DateTime @default(now()) @updatedAt @map("guncelleme_tarihi") @db.Timestamptz(6)

  @@map("sistem_ayari")
}

// ---------------------------------------------------------------------------
// 9. İletişim modülü
// ---------------------------------------------------------------------------
//
// TASARIMIN TEMELİ: sistemde GİZLİ KANAL YOKTUR. Her mesaj, tarafların danışman
// öğretmenlerine, illerinin koordinatörlerine ve proje yöneticilerine görünür.
// Kullanıcıların çoğu 18 yaş altı olduğu için mahremiyet vaadi verilmiyor;
// verilseydi tutulamazdı. Bu, ekranda kalıcı olarak yazılı ve aydınlatma
// metninde beyan edilmiş durumda.

/// Öğrencinin açtığı ilan: "şu alan için takım arkadaşı arıyorum".
/// Kişiden kişiye temas İÇERMEZ; modülün en düşük riskli parçasıdır.
/// Panodaki ilanın ne aradığı. NULL kabul eder: tür alanı 6 Ağustos 2026'da
/// eklendi ve eski ilanlarda bilinmiyor. Geriye dönük doldurulmadı — varsayılan
/// atamak, filtrelenen listeyi sessizce yanlışlardı. Zorunluluk uygulama
/// katmanında ve yalnızca yeni ilanlarda.
enum TalepTuru {
  EKIP_ARKADASI
  TEKNIK_DESTEK
  SPONSOR
  /// Tanıtım / yaygınlaştırma duyurusu. Ekranda "Duyuru / tanıtım desteği"
  /// yazar (11 Ağustos 2026'ya kadar "Genel" yazıyordu).
  DUYURU
  /// Yukarıdakilerin hiçbirine girmeyen ilan (14 Ağustos 2026 · istek:
  /// "kategoriler … ve genel şeklinde kategoriler olsun").
  ///
  /// DUYURU'YU YENİDEN ADLANDIRMAK YETMEZDİ: istek "duyuru / tanıtım desteği"
  /// ile "genel"i aynı listede sayıyor, yani ikisi ayrı kategori. Etiketi geri
  /// almak, açılmış duyuru ilanlarını sessizce genel kutusuna taşırdı.
  GENEL
  /// Deneyimli birine danışma isteği (7 Ağustos 2026).
  ///
  /// TEKNIK_DESTEK'ten ayrı: o bir SORUNU çözdürmek için açılır ("kodum
  /// çalışmıyor"), bu bir YOL sorar ("hangi alana gitmeliyim"). Tek türde
  /// toplansalardı mentor arayan öğrenci teknik soruların arasında kaybolurdu.
  MENTORE_SOR
}

model Talep {
  id              Int        @id @default(autoincrement())
  acanKullaniciId Int        @map("acan_kullanici_id")
  tur             TalepTuru?
  /// İlanın ilgili olduğu çalışma alanı. Boş olabilir: her ilan bir gruba
  /// girmeyebilir ve zorlamak kullanıcıyı yanlış grup seçmeye iter.
  calismaGrubuId  Int?       @map("calisma_grubu_id")
  baslik          String     @db.VarChar(200)
  icerik          String     @db.Text
  /// Panonun çürümemesi için son gün. Süresi dolan ilan listelenmez ama
  /// SİLİNMEZ — kimin ne aradığı geçmiş kaydıdır.
  sonGecerlilik   DateTime   @map("son_gecerlilik") @db.Timestamptz(6)
  kapatildiMi     Boolean    @default(false) @map("kapatildi_mi")
  /// ÖĞRENCİ İLANI ÖNCE ONAYA DÜŞER (14 Ağustos 2026 · istek: "panodaki
  /// öğrenci ilanları şimdilik proje yöneticilerine düşsün oradan onay
  /// versin"). Kararı proje yöneticisi verir; onaylanana kadar ilan panoda
  /// GÖRÜNMEZ, yalnızca sahibi "Açık ilanlarım" listesinde durumuyla görür.
  ///
  /// VARSAYILAN `ONAY_GEREKMEZ` ve bu, geçmiş kayıtları koruyan tercihtir:
  /// sütun eklendiğinde panoda duran her ilan görünür kalır. Öğrenci dışındaki
  /// açanlar (öğretmen, mezun, paydaş temsilcisi) da bu değerle yazılır —
  /// istek yalnızca ÖĞRENCİ ilanları için onay istiyor. `BEKLIYOR` yalnızca
  /// öğrencinin açtığı yeni ilana konur (bkz. panoIlaniOnayGerekiyorMu).
  onayDurumu           OnayDurumu @default(ONAY_GEREKMEZ) @map("onay_durumu")
  onaylayanKullaniciId Int?       @map("onaylayan_kullanici_id")
  onayTarihi           DateTime?  @map("onay_tarihi") @db.Timestamptz(6)
  /// Ret gerekçesi zorunludur: öğrenci ilanının neden yayımlanmadığını
  /// görmeden yeniden yazıp yazmayacağına karar veremez (emsali
  /// baglanti_istegi.ret_gerekcesi).
  retGerekcesi         String?    @map("ret_gerekcesi") @db.Text
  olusturmaTarihi DateTime   @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)

  acan         Kullanici        @relation("TalepAcan", fields: [acanKullaniciId], references: [id])
  onaylayan    Kullanici?       @relation("TalepOnaylayan", fields: [onaylayanKullaniciId], references: [id])
  calismaGrubu CalismaGrubu?    @relation(fields: [calismaGrubuId], references: [id])
  istekler     BaglantiIstegi[]
  cevaplar     TalepCevabi[]

  @@index([acanKullaniciId])
  @@index([calismaGrubuId])
  @@index([kapatildiMi, sonGecerlilik])
  @@index([tur])
  /// Onay kuyruğu "bekleyenler en eski üstte" diye okunuyor.
  @@index([onayDurumu, olusturmaTarihi])
  @@map("talep")
}

/// İL KOORDİNATÖRÜNÜN KURDUĞU EKİP (13 Ağustos 2026).
///
/// İstek: "il koordinatörü ekipler kurabilsin, ekip ismini kendileri girsin,
/// ekiplere katılanlarla mesajlaşma sohbet yapabilsin".
///
/// ÇALIŞMA GRUBUNDAN AYRI TABLO ve bu bilinçli: `calisma_grubu` merkezin
/// tanımladığı SABİT listedir (Yapay Zekâ, Robotik…), ülke genelinde aynıdır ve
/// öğrenci ona kendisi katılır. Ekip ise ilin kendi kurduğu, adını kendi
/// koyduğu, üyesini tek tek seçtiği bir topluluktur. İkisi tek tabloya
/// konsaydı, "ilimdeki ekip" ile "ülke genelindeki çalışma alanı" aynı süzgece
/// düşer ve öğrencinin katılabildiği liste ilden ile değişirdi.
///
/// İLE BAĞLIDIR: kuran koordinatörün ili yazılır. Kapsam kuralı buradan çıkar —
/// koordinatör kendi ilinin ekiplerini yönetir, merkez hepsini görür.
///
/// SİLME YOK, PASİFE ALMA VAR (calisma_grubu ile aynı): dağılan ekibin
/// mesajları ve üye geçmişi kayıt olarak kalır.
/// Ekibin niteliği (15 Ağustos 2026 · manisa-farklari-plani.md · Aşama 5).
///
/// Ekipler bugüne kadar tek tipti ve hepsi il seviyesinde kuruluyordu. Üç tür
/// ayrımı, ekip listesinin 100'ü aşınca okunamaz hâle gelmesinden doğdu:
/// "hangi okulun takımı" ile "ilin çalışma grubu" aynı listede ayırt
/// edilemiyordu.
enum EkipTuru {
  /// Bir okula bağlı takım; `kurumKodu` ZORUNLUDUR (ck_ekip_okul_takimi_kurum).
  OKUL_TAKIMI
  /// İl içinde konu bazlı çalışma grubu. Varsayılan tür — mevcut kayıtların
  /// tamamı bu, çünkü hepsi il seviyesinde kurulmuştu.
  CALISMA_GRUBU
  /// İlin GençTek ekibi; ilde tek olması beklenir ama kısıtla ZORLANMAZ
  /// (dönem geçişlerinde iki ekibin bir süre birlikte durması olağan).
  IL_GENCTEK_EKIBI
}

model Ekip {
  id                  Int      @id @default(autoincrement())
  ad                  String   @db.VarChar(150)
  aciklama            String?  @db.Text
  ilKodu              String   @map("il_kodu") @db.VarChar(2)
  /// Varsayılan CALISMA_GRUBU: mevcut kayıtların hepsi il seviyesinde
  /// kurulmuştu, göç sırasında veri düzeltmesi gerekmiyor.
  tur                 EkipTuru @default(CALISMA_GRUBU)
  /// OKUL_TAKIMI türünde ZORUNLU, diğerlerinde NULL kalır. Kısıt migration'da
  /// (ck_ekip_okul_takimi_kurum) — `ck_ogrenci_gorev_kapsam` ile aynı desen:
  /// kapsam sütunu türüne göre zorunlu.
  kurumKodu           Int?     @map("kurum_kodu")
  /// Ekibin danışman öğretmeni. NULL KALABİLİR ve bu bir eksiklik değil, aranan
  /// şeyin ta kendisi: "danışmansız ekipler" listesi bu sütuna bakıyor. Zorunlu
  /// yapılsaydı o liste hiçbir zaman dolmazdı.
  danismanKullaniciId Int?     @map("danisman_kullanici_id")
  kuranKullaniciId    Int      @map("kuran_kullanici_id")
  aktif               Boolean  @default(true)
  olusturmaTarihi     DateTime @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)

  il       Il          @relation(fields: [ilKodu], references: [ilKodu])
  kurum    Kurum?      @relation(fields: [kurumKodu], references: [kurumKodu])
  danisman Kullanici?  @relation("EkipDanismani", fields: [danismanKullaniciId], references: [id])
  kuran    Kullanici   @relation("EkipKuran", fields: [kuranKullaniciId], references: [id])
  uyeler   EkipUyesi[]
  mesajlar EkipMesaji[]

  @@index([ilKodu, aktif])
  @@index([kuranKullaniciId])
  @@index([kurumKodu])
  @@index([danismanKullaniciId])
  @@map("ekip")
}

/// Ekip üyeliği.
///
/// ÇIKARILAN ÜYE SATIRI SİLİNİR (yazışmadaki gibi "bitiş tarihi" tutulmaz):
/// üyelik bir görev değil bir katılımdır ve geçmişi rapor edilmiyor. Kişinin
/// yazdığı mesajlar kalır — onlar kaydın kendisidir.
model EkipUyesi {
  ekipId          Int      @map("ekip_id")
  kullaniciId     Int      @map("kullanici_id")
  eklenmeTarihi   DateTime @default(now()) @map("eklenme_tarihi") @db.Timestamptz(6)

  ekip      Ekip      @relation(fields: [ekipId], references: [id], onDelete: Cascade)
  kullanici Kullanici @relation("EkipUyesi", fields: [kullaniciId], references: [id])

  @@id([ekipId, kullaniciId])
  @@index([kullaniciId])
  @@map("ekip_uyesi")
}

/// Ekip sohbetindeki mesaj.
///
/// GİZLİ KANAL DEĞİLDİR (lib/iletisim/kurallar.ts ile aynı ilke): ekibi kuran
/// koordinatör ve proje yöneticisi mesajları okur. Kullanıcıların çoğu 18 yaş
/// altı; okunmayan bir kanal vaadi verilmiyor çünkü tutulamazdı.
///
/// SİLME YOK, GİZLEME VAR — model Mesaj ve model Gonderi ile aynı gerekçe.
model EkipMesaji {
  id                  Int       @id @default(autoincrement())
  ekipId              Int       @map("ekip_id")
  yazanKullaniciId    Int       @map("yazan_kullanici_id")
  icerik              String    @db.Text
  olusturmaTarihi     DateTime  @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  gizlendiMi          Boolean   @default(false) @map("gizlendi_mi")
  gizleyenKullaniciId Int?      @map("gizleyen_kullanici_id")
  gizlenmeTarihi      DateTime? @map("gizlenme_tarihi") @db.Timestamptz(6)

  ekip     Ekip       @relation(fields: [ekipId], references: [id], onDelete: Cascade)
  yazan    Kullanici  @relation("EkipMesajiYazan", fields: [yazanKullaniciId], references: [id])
  gizleyen Kullanici? @relation("EkipMesajiGizleyen", fields: [gizleyenKullaniciId], references: [id])

  @@index([ekipId, olusturmaTarihi])
  @@map("ekip_mesaji")
}

/// Panodaki bir ilana yazılan CEVAP (13 Ağustos 2026).
///
/// İstek: "mentörlerin kendi sayfası olsun, destek atacağı sayfayı görecek,
/// talepleri inceleyip cevap yazacak".
///
/// NİYE AÇIK CEVAP, ÖZEL MESAJ DEĞİL: bu sistemde yetişkin ile 18 yaş altı
/// kullanıcı arasındaki BİREBİR yazışma danışman/koordinatör onayından geçer
/// (bkz. model BaglantiIstegi) ve bu kural gevşetilmedi. Panoya yazılan cevap
/// ise ilanı gören herkesin okuduğu bir metindir — ilan zaten açıktır ve cevabı
/// da açık olması, aynı soruyu soracak ikinci öğrenciye de yarar. Mentör
/// birebir konuşmak isterse yolu yine bağlantı isteğidir.
///
/// SİLME YOKTUR, GİZLEME VARDIR (model Gonderi ile aynı gerekçe): içerik
/// korunur, çünkü şikâyet incelemesinde en çok ihtiyaç duyulan kayıt silinmiş
/// olandır. Gizleme yetkisi gözetim rollerindedir (danışman, il koordinatörü,
/// proje yöneticisi) ve yazarın kendisi de gizleyebilir.
model TalepCevabi {
  id                  Int       @id @default(autoincrement())
  talepId             Int       @map("talep_id")
  yazanKullaniciId    Int       @map("yazan_kullanici_id")
  icerik              String    @db.Text
  olusturmaTarihi     DateTime  @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  gizlendiMi          Boolean   @default(false) @map("gizlendi_mi")
  gizleyenKullaniciId Int?      @map("gizleyen_kullanici_id")
  gizlenmeTarihi      DateTime? @map("gizlenme_tarihi") @db.Timestamptz(6)

  talep    Talep      @relation(fields: [talepId], references: [id])
  yazan    Kullanici  @relation("TalepCevabiYazan", fields: [yazanKullaniciId], references: [id])
  gizleyen Kullanici? @relation("TalepCevabiGizleyen", fields: [gizleyenKullaniciId], references: [id])

  @@index([talepId, olusturmaTarihi])
  @@index([yazanKullaniciId, olusturmaTarihi])
  @@map("talep_cevabi")
}

/// İki kişi arasında yazışma açılabilmesi için gereken onay.
///
/// Onaylayan, isteği yapanın danışmanı YA DA ilinin koordinatörü olabilir.
/// Yalnızca koordinatöre bırakılsaydı il başına tek kişi yüzlerce isteğin
/// darboğazı olurdu; danışman öğrencisini zaten tanıyor.
model BaglantiIstegi {
  id                    Int        @id @default(autoincrement())
  talepId               Int?       @map("talep_id")
  isteyenKullaniciId    Int        @map("isteyen_kullanici_id")
  hedefKullaniciId      Int        @map("hedef_kullanici_id")
  mesaj                 String     @db.Text
  onayDurumu            OnayDurumu @default(BEKLIYOR) @map("onay_durumu")
  kararVerenKullaniciId Int?       @map("karar_veren_kullanici_id")
  kararTarihi           DateTime?  @map("karar_tarihi") @db.Timestamptz(6)
  retGerekcesi          String?    @map("ret_gerekcesi") @db.Text
  olusturmaTarihi       DateTime   @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)

  talep      Talep?     @relation(fields: [talepId], references: [id])
  isteyen    Kullanici  @relation("BaglantiIsteyen", fields: [isteyenKullaniciId], references: [id])
  hedef      Kullanici  @relation("BaglantiHedefi", fields: [hedefKullaniciId], references: [id])
  kararVeren Kullanici? @relation("BaglantiKararVeren", fields: [kararVerenKullaniciId], references: [id])
  yazisma    Yazisma?

  @@index([onayDurumu])
  @@index([hedefKullaniciId])
  @@map("baglanti_istegi")
}

/// Onaylanmış bağlantının konuşması. Bağlantı olmadan yazışma açılamaz,
/// bu yüzden birincil anahtar isteğin kendisidir.
model Yazisma {
  baglantiIstegiId Int      @id @map("baglanti_istegi_id")
  olusturmaTarihi  DateTime @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  kapatildiMi      Boolean  @default(false) @map("kapatildi_mi")

  baglantiIstegi BaglantiIstegi @relation(fields: [baglantiIstegiId], references: [id], onDelete: Cascade)
  mesajlar       Mesaj[]

  @@map("yazisma")
}

model Mesaj {
  id                  Int      @id @default(autoincrement())
  yazismaId           Int      @map("yazisma_id")
  yazanKullaniciId    Int      @map("yazan_kullanici_id")
  icerik              String   @db.Text
  /// SİLME YOKTUR, gizleme vardır: içerik korunur çünkü şikâyet incelemesinde
  /// silinmiş bir mesaj en çok ihtiyaç duyulan kayıttır.
  gizlendiMi          Boolean  @default(false) @map("gizlendi_mi")
  gizleyenKullaniciId Int?     @map("gizleyen_kullanici_id")
  olusturmaTarihi     DateTime @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)

  yazisma  Yazisma    @relation(fields: [yazismaId], references: [baglantiIstegiId], onDelete: Cascade)
  yazan    Kullanici  @relation("MesajYazan", fields: [yazanKullaniciId], references: [id])
  gizleyen Kullanici? @relation("MesajGizleyen", fields: [gizleyenKullaniciId], references: [id])

  @@index([yazismaId, olusturmaTarihi])
  @@map("mesaj")
}

// ---------------------------------------------------------------------------
// 13. Akış: gönderi ve yorum
// ---------------------------------------------------------------------------

/// Kullanıcının kendi yazdığı paylaşım — LinkedIn'in gönderisi (12 Ağustos
/// 2026 · istek: "kullanıcı linkedin gibi mesaj yazabilsin, o alanda kendini
/// tanıtabilsin, diğer kişiler altına mesaj yazabilsin, kariyeri hakkında
/// paylaşım yapabilsin").
///
/// YAZIŞMADAN TEMELDEN FARKLI BİR ŞEYDİR ve karıştırılmamalı:
///   - Yazışma İKİ KİŞİ arasındadır ve danışman onayı olmadan açılmaz.
///   - Gönderi YAYINDIR; ekosistemdeki herkes okur, kimseden onay istemez.
/// Bu yüzden bağlantı kapısı (baglanti_istegi) buraya UYGULANMAZ: onay kapısı
/// "bu iki kişi birbirine özel yazabilsin mi" sorusunu çözer, "bu kişi
/// herkese açık bir şey yayınlayabilir mi" sorusunu değil. Panodaki ilan da
/// (model Talep) yıllardır bu ikinci kategoride duruyor ve emsali odur.
///
/// GÖRÜNÜRLÜK EKOSİSTEMLE SINIRLIDIR (S21 ile aynı ilke): gönderiyi yalnızca
/// sisteme girmiş kullanıcılar okur. Dışarıya açık bir akış sayfası ayrı bir
/// karardır ve KVKK açısından yeniden değerlendirilmelidir.
///
/// SİLME YOKTUR, GİZLEME VARDIR — model Mesaj ile birebir aynı gerekçe:
/// içerik korunur çünkü şikâyet incelemesinde en çok ihtiyaç duyulan kayıt
/// silinmiş olandır. Yazarın kendisi de gizler; geri alması yoktur.
model Gonderi {
  id                  Int       @id @default(autoincrement())
  yazanKullaniciId    Int       @map("yazan_kullanici_id")
  icerik              String    @db.Text
  olusturmaTarihi     DateTime  @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  gizlendiMi          Boolean   @default(false) @map("gizlendi_mi")
  gizleyenKullaniciId Int?      @map("gizleyen_kullanici_id")
  gizlenmeTarihi      DateTime? @map("gizlenme_tarihi") @db.Timestamptz(6)

  yazan    Kullanici       @relation("GonderiYazan", fields: [yazanKullaniciId], references: [id])
  gizleyen Kullanici?      @relation("GonderiGizleyen", fields: [gizleyenKullaniciId], references: [id])
  yorumlar GonderiYorumu[]

  @@index([olusturmaTarihi])
  @@index([yazanKullaniciId, olusturmaTarihi])
  @@map("gonderi")
}

/// Gönderinin altındaki yorum.
///
/// model Yorum'dan AYRI TABLO, kasıtlı: o tablo `faaliyet_id` üzerine kurulu
/// ve NOT NULL — gönderi yorumunu oraya sığdırmak, sütunu isteğe bağlı yapıp
/// "ikisinden biri dolu" kısıtını uygulama katmanına taşımak demekti. İki
/// ayrı tablo, iki ayrı yabancı anahtar kısıtı bırakır.
///
/// Yanıt zinciri YOK (model Yorum'da var): gönderi akışı sığ okunur, iç içe
/// yanıt ekranı derinleştirir ve moderasyonu zorlaştırır. Gerekirse sonradan
/// eklenir; bugünden eklemek kullanılmayan bir kısıt taşımak olurdu.
model GonderiYorumu {
  id                  Int       @id @default(autoincrement())
  gonderiId           Int       @map("gonderi_id")
  yazanKullaniciId    Int       @map("yazan_kullanici_id")
  icerik              String    @db.Text
  olusturmaTarihi     DateTime  @default(now()) @map("olusturma_tarihi") @db.Timestamptz(6)
  gizlendiMi          Boolean   @default(false) @map("gizlendi_mi")
  gizleyenKullaniciId Int?      @map("gizleyen_kullanici_id")
  gizlenmeTarihi      DateTime? @map("gizlenme_tarihi") @db.Timestamptz(6)

  gonderi  Gonderi    @relation(fields: [gonderiId], references: [id], onDelete: Cascade)
  yazan    Kullanici  @relation("GonderiYorumuYazan", fields: [yazanKullaniciId], references: [id])
  gizleyen Kullanici? @relation("GonderiYorumuGizleyen", fields: [gizleyenKullaniciId], references: [id])

  @@index([gonderiId, olusturmaTarihi])
  @@map("gonderi_yorumu")
}
