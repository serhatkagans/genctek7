# GençTek kopya servisi (ŞABLON) — /etc/systemd/system/genctek@.service
#
# NİYE ŞABLON: uygulama üç kopya çalışıyor (2 Eylül 2026). Ana kopya
# genctek.service (3010), diğer ikisi bu şablondan türer: örnek adı %i doğrudan
# PORT olarak kullanılıyor, yani `genctek@3020` 3020'yi dinler. Kopya başına
# ayrı dosya yazılsaydı üçü birlikte güncellenmek zorunda kalırdı.
#
# BU DOSYA DEPODA YOKTU (3 Eylül 2026'da eklendi): şablon yalnızca sunucuda
# duruyordu, yani üç kopyalı kurulum depodan yeniden kurulamıyordu.
#
# Kurulum:
#   sudo cp dagitim/genctek@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now genctek@3020 genctek@3021
#
# Günlükler:  journalctl -u genctek@3020 -f
#
# KOPYA LİSTESİ ÜÇ YERDE: burası (hangi örnekler enable edilecek),
# guncelle.sh içindeki KOPYALAR ve vhost'taki BalancerMember satırları.
# Üçü birlikte güncellenmelidir.

[Unit]
Description=GençTek Bilgi Sistemi (kopya %i)
Documentation=file:/opt/genctek/DAGITIM.md
# Veritabanı hazır olmadan açılırsa uygulama ilk isteklerde hata verir.
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
# Açılışta çöküp duran bir sürüm sonsuz döngüye girmesin. Bu iki anahtar
# [Unit] bölümüne aittir; [Service] altında systemd onları yok sayar.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=genctek
Group=genctek
WorkingDirectory=/opt/genctek

# Ortam değişkenleri .env'den okunur. Dosya 600 izinli ve genctek kullanıcısına
# ait olmalı: içinde veritabanı şifresi ve oturum imza anahtarı var.
EnvironmentFile=/opt/genctek/.env
Environment=NODE_ENV=production
# PORT = örnek adı: `genctek@3020` -> 3020. Tek kaynak, ayrıca yazılmıyor.
Environment=PORT=%i
# Yalnızca yerel arayüzü dinler; dışarıya ters vekil açar. Uygulamayı 0.0.0.0'a
# bağlamak, güvenlik duvarı yanlış yapılandırılırsa paneli doğrudan internete
# açardı.
#
# TERS VEKİL APACHE/DirectAdmin'dir, nginx DEĞİL: kurallar
# /usr/local/directadmin/data/users/admin/domains/aiotechs.cloud.cust_httpd
# içinde ve /genctek isteklerini balancer://genctek'e veriyor. Depodaki
# dagitim/nginx-genctek.conf KULLANILMIYOR.
Environment=HOSTNAME=127.0.0.1

# Standalone çıktı çalıştırılır (next.config.ts · output: "standalone").
# guncelle.sh derlemeden sonra .next/static'i buraya kopyalar.
# NODE'UN TAM YOLU, /usr/bin/node DEĞİL: sistemdeki Node 16 ve Prisma 7 onunla
# WASM hatasıyla ölüyor. Bu satır sunucuda elle düzeltilmişti ve depoya geri
# yazılmamıştı; depodaki dosyayla kurulum yapan çalışmayan bir servis kuruyordu.
ExecStart=/opt/node24/bin/node /opt/genctek/.next/standalone/server.js

Restart=on-failure
RestartSec=5

# --- Sıkılaştırma ---------------------------------------------------------
# Uygulamanın yazması gereken TEK dizin dosya deposudur; gerisi salt okunur.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/genctek/depolama
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=genctek

[Install]
WantedBy=multi-user.target
